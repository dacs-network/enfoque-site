---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Fale Conosco | Enfoque Ambiental"
  description="Entre em contato com a Enfoque Ambiental para coleta e transporte de resíduos e consultoria ambiental."
  currentPath="/contato"
>
  <!-- Page Header -->
  <section class="bg-[#003300] text-white py-12 md:py-16 border-b border-emerald-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl space-y-2">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight">
          Fale Conosco
        </h1>
        <p class="text-emerald-100/90 text-base sm:text-lg">
          Entre em contato através dos telefones, e-mail ou pelo formulário abaixo.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact & Map Section -->
  <section class="py-16 md:py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <!-- Contact Information & Form -->
        <div class="lg:col-span-6 space-y-8">
          <!-- Cards de Contato -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-xs flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-[#003300] text-[#a6d37e] flex items-center justify-center shrink-0">
                <i class="fa-solid fa-phone text-xl" aria-hidden="true"></i>
              </div>
              <div>
                <h2 class="text-sm font-bold text-gray-900">Telefones</h2>
                <p class="text-sm text-gray-600 mt-1">
                  <a href="tel:1935417975" class="hover:text-[#006400]">(19) 3541-7975</a>
                </p>
                <p class="text-sm text-gray-600">
                  <a href="tel:1933219111" class="hover:text-[#006400]">(19) 3321-9111</a>
                </p>
              </div>
            </div>

            <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-xs flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-[#003300] text-[#a6d37e] flex items-center justify-center shrink-0">
                <i class="fa-solid fa-envelope text-xl" aria-hidden="true"></i>
              </div>
              <div>
                <h2 class="text-sm font-bold text-gray-900">E-mail</h2>
                <p class="text-sm text-gray-600 mt-1 break-all">
                  <a href="mailto:contato@enfoqueambiental.com.br" class="hover:text-[#006400]">contato@enfoqueambiental.com.br</a>
                </p>
              </div>
            </div>
          </div>

          <!-- Formulário de Mensagem -->
          <div class="bg-white p-8 rounded-2xl border border-gray-200 shadow-xs">
            <h3 class="text-xl font-bold text-[#003300] mb-6 flex items-center gap-2">
              <i class="fa-solid fa-file-pen text-[#006400]" aria-hidden="true"></i>
              <span>Envie sua Mensagem</span>
            </h3>

            <form class="space-y-4" onsubmit="event.preventDefault(); alert('Mensagem enviada com sucesso! Entraremos em contato.');">
              <div>
                <label for="name" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                  Nome / Empresa
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Seu nome ou empresa"
                  class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#006400] focus:border-transparent outline-hidden text-sm"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="email" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                    E-mail
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    placeholder="email@empresa.com.br"
                    class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#006400] focus:border-transparent outline-hidden text-sm"
                  />
                </div>

                <div>
                  <label for="phone" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                    Telefone
                  </label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    required
                    placeholder="(19) 99999-9999"
                    class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#006400] focus:border-transparent outline-hidden text-sm"
                  />
                </div>
              </div>

              <div>
                <label for="service" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                  Assunto
                </label>
                <select
                  id="service"
                  name="service"
                  class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#006400] focus:border-transparent outline-hidden text-sm text-gray-700"
                >
                  <option value="coleta">Coleta e Transporte de Resíduos</option>
                  <option value="consultoria">Consultoria e Licenciamento CETESB</option>
                  <option value="gerenciamento">Gerenciamento de Resíduos</option>
                  <option value="outro">Outros</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                  Mensagem
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  required
                  placeholder="Escreva sua mensagem..."
                  class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-[#006400] focus:border-transparent outline-hidden text-sm"
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full bg-[#006400] hover:bg-[#004d00] text-white font-bold py-3 px-6 rounded-lg shadow-sm hover:shadow transition-all flex items-center justify-center gap-2"
              >
                <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
                <span>Fale Conosco</span>
              </button>
            </form>
          </div>
        </div>

        <!-- Address & Google Maps Embed -->
        <div class="lg:col-span-6 space-y-6">
          <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-xs space-y-4">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-[#003300] text-[#a6d37e] flex items-center justify-center shrink-0">
                <i class="fa-solid fa-map-location-dot text-xl" aria-hidden="true"></i>
              </div>
              <div>
                <h3 class="font-bold text-gray-900 text-lg">Sede</h3>
                <p class="text-sm text-gray-600 mt-1 leading-relaxed">
                  Rua Ruperto Malaman, 380 • Distrito Industrial<br />
                  Araras - SP • CEP 13602-104
                </p>
              </div>
            </div>

            <!-- Map Container -->
            <div class="rounded-xl overflow-hidden border border-gray-200 h-[380px] w-full">
              <iframe
                title="Mapa de localização Enfoque Ambiental"
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3689.414123042048!2d-47.40495368591002!3d-22.375740485284382!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94c877717736f837%3A0x3214a39d587a308f!2sR.+Ruperto+Malaman%2C+380%2C+Araras+-+SP%2C+13602-104!5e0!3m2!1spt-BR!2sbr!4v1500000000000"
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
