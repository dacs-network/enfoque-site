---
import Layout from "../layouts/Layout.astro";
import FleetGrid from "../components/FleetGrid.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title={t("equipamentos.meta.title")}
  description={t("equipamentos.meta.description")}
  currentPath="/equipamentos"
>
  <section class="bg-[#003300] text-white py-12 md:py-16 border-b border-emerald-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl space-y-2">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight">
          {t("equipamentos.hero.title")}
        </h1>
        <p class="text-emerald-100/90 text-base sm:text-lg">
          {t("equipamentos.hero.subtitle")}
        </p>
      </div>
    </div>
  </section>

  <FleetGrid showTitle={false} />

  <!-- Fechamento Único de Conversão -->
  <section class="pb-16 md:pb-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="bg-[#003300] text-white p-8 sm:p-10 rounded-2xl shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div class="space-y-1">
          <h2 class="text-xl font-bold text-white">
            {t("equipamentos.cta.title")}
          </h2>
          <p class="text-sm text-emerald-100/80">
            {t("equipamentos.cta.desc")}
          </p>
        </div>
        <a
          href="/contato"
          class="inline-flex items-center justify-center bg-[#006400] hover:bg-[#004d00] text-white font-bold text-sm px-6 py-3 rounded-lg shadow-sm hover:shadow transition-all shrink-0"
        >
          {t("cta.contact")}
        </a>
      </div>
    </div>
  </section>
</Layout>
