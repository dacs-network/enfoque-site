---
import Layout from "../layouts/Layout.astro";
import FleetGrid from "../components/FleetGrid.astro";
---

<Layout
  title="Equipamentos | Enfoque Ambiental"
  description="Conheça a frota e os equipamentos da Enfoque Ambiental: Roll-on Roll-off, Auto Vácuo, Tanque, Plataforma e Hidrojateamento."
  currentPath="/equipamentos"
>
  <section class="bg-[#003300] text-white py-12 md:py-16 border-b border-emerald-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl space-y-2">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight">
          Nossos Equipamentos
        </h1>
        <p class="text-emerald-100/90 text-base sm:text-lg">
          Equipamentos para transporte, coleta e destinação de resíduos em conformidade com as normas vigentes.
        </p>
      </div>
    </div>
  </section>

  <FleetGrid showTitle={false} />
</Layout>
