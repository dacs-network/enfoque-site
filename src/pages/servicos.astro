---
import Layout from "../layouts/Layout.astro";

const services = [
  {
    title: "Transporte de Resíduos",
    icon: "fa-solid fa-truck-moving",
    image: "/img/servico-transporte-residuo.jpg",
    description: "Coleta e transporte de resíduos perigosos (Classe I) e não perigosos (Classe II A e II B), efluentes industriais e entulhos com destinação final homologada perante a CETESB.",
    items: [
      "Atendimento a acidentes com produtos químicos",
      "Coleta e transporte de efluentes industriais",
      "Resíduos Classe I (Perigosos) e Classe II (Não perigosos)",
      "Caçambas de 15m³ para entulho e materiais industriais",
    ],
  },
  {
    title: "Serviços de Consultoria e Assessoria",
    icon: "fa-solid fa-file-contract",
    image: "/img/servico-consultoria-ambiental.png",
    description: "Assessoria técnica especializada perante órgãos ambientais reguladores municipais, estaduais e federais.",
    items: [
      "Licenciamento ambiental junto à CETESB (LP, LI, LO e CDL)",
      "Solicitação e renovação de CADRI junto à CETESB",
      "Cadastro Técnico Federal e Certificado de Regularidade no IBAMA",
      "Outorgas de direito de uso de recursos hídricos junto ao DAEE",
      "Elaboração de Plano de Gerenciamento de Resíduos Sólidos (PGRS)",
    ],
  },
  {
    title: "Serviços de Gerenciamento",
    icon: "fa-solid fa-list-check",
    image: "/img/slides/slide3.png",
    description: "Gestão integrada de resíduos na fonte geradora, minimizando impactos e assegurando total conformidade jurídica e fiscal.",
    items: [
      "Classificação e caracterização de resíduos industriais",
      "Implantação de coleta seletiva e procedimentos operacionais",
      "Controle de manifesto de transporte e rastreabilidade total",
    ],
  },
];
---

<Layout
  title="Serviços | Enfoque Ambiental"
  description="Conheça os serviços de coleta, transporte de resíduos, hidrojateamento, licenciamento CETESB e consultoria ambiental da Enfoque Ambiental."
  currentPath="/servicos"
>
  <!-- Page Header -->
  <section class="bg-[#003300] text-white py-12 md:py-16 border-b border-emerald-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl space-y-3">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#a6d37e]/20 text-[#a6d37e] text-xs font-bold uppercase tracking-wider">
          <i class="fa-solid fa-briefcase" aria-hidden="true"></i>
          <span>Portfólio de Atuação</span>
        </span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight">
          Nossos Serviços
        </h1>
        <p class="text-emerald-100/90 text-base sm:text-lg">
          Soluções completas e integradas para regularização ambiental, transporte especializado e descarte de resíduos industriais.
        </p>
      </div>
    </div>
  </section>

  <!-- Services Listing -->
  <section class="py-16 md:py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 space-y-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {services.map((serv) => (
          <div class="bg-white rounded-2xl overflow-hidden border border-gray-200 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
            <div>
              <div class="h-48 overflow-hidden bg-gray-100 relative">
                <img
                  src={serv.image}
                  alt={serv.title}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
                <div class="absolute top-4 left-4 w-10 h-10 rounded-lg bg-[#003300] text-[#a6d37e] flex items-center justify-center shadow-md">
                  <i class={`${serv.icon} text-lg`} aria-hidden="true"></i>
                </div>
              </div>

              <div class="p-6 space-y-4">
                <h2 class="text-xl font-bold text-[#003300]">
                  {serv.title}
                </h2>
                <p class="text-gray-600 text-sm leading-relaxed">
                  {serv.description}
                </p>

                <div class="pt-2">
                  <h3 class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-2">Escopo do Serviço:</h3>
                  <ul class="space-y-1.5 text-xs text-gray-700">
                    {serv.items.map((item) => (
                      <li class="flex items-start gap-2">
                        <i class="fa-solid fa-check text-[#006400] mt-0.5" aria-hidden="true"></i>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>

            <div class="p-6 pt-0 mt-4">
              <a
                href="/contato"
                class="inline-flex items-center justify-center gap-2 w-full bg-[#006400] hover:bg-[#004d00] text-white font-semibold text-sm py-2.5 rounded-lg transition-colors"
              >
                <span>Solicitar Proposta</span>
                <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
