---
import Layout from "../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title={t("servicos.meta.title")}
  description={t("servicos.meta.description")}
  currentPath="/servicos"
>
  <section class="bg-[#003300] text-white py-12 md:py-16 border-b border-emerald-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl space-y-2">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight">
          {t("servicos.hero.title")}
        </h1>
        <p class="text-emerald-100/90 text-base sm:text-lg">
          {t("servicos.hero.subtitle")}
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 space-y-16">
      
      <!-- FRENTE 1: Operações e Logística de Resíduos -->
      <div class="space-y-8">
        <div class="border-b border-gray-200 pb-4 max-w-3xl">
          <span class="text-xs font-bold uppercase tracking-wider text-[#006400]">
            {t("servicos.ops.badge")}
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-[#003300] tracking-tight">
            {t("servicos.ops.title")}
          </h2>
          <p class="text-sm text-gray-600 mt-1">
            {t("servicos.ops.desc")}
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <!-- Card de Destaque Operacional -->
          <div class="lg:col-span-7 bg-white rounded-2xl border border-gray-200 shadow-xs overflow-hidden">
            <div class="h-64 sm:h-72 overflow-hidden bg-gray-100 relative">
              <img
                src="/img/servico-transporte-residuo.webp"
                alt={t("servicos.ops.transport.title")}
                class="w-full h-full object-cover"
                loading="lazy"
              />
              <div class="absolute bottom-4 left-4 bg-[#003300]/90 backdrop-blur-xs text-white text-xs font-semibold px-3 py-1.5 rounded-lg border border-emerald-700/40">
                {t("servicos.ops.highlightBadge")}
              </div>
            </div>
            <div class="p-6 sm:p-8 space-y-4">
              <h3 class="text-xl font-bold text-[#003300]">
                {t("servicos.ops.transport.title")}
              </h3>
              <p class="text-gray-700 text-sm leading-relaxed">
                {t("servicos.ops.transport.desc")}
              </p>
              <div class="space-y-2 pt-2 border-t border-gray-100">
                <span class="text-xs font-bold text-gray-700 uppercase tracking-wider block">{t("servicos.ops.transport.scopeTitle")}</span>
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs sm:text-sm text-gray-700">
                  <li class="flex items-start gap-2">
                    <i class="fa-solid fa-check text-[#006400] mt-1 shrink-0" aria-hidden="true"></i>
                    <span>{t("servicos.ops.transport.item1")}</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <i class="fa-solid fa-check text-[#006400] mt-1 shrink-0" aria-hidden="true"></i>
                    <span>{t("servicos.ops.transport.item2")}</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <i class="fa-solid fa-check text-[#006400] mt-1 shrink-0" aria-hidden="true"></i>
                    <span>{t("servicos.ops.transport.item3")}</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <i class="fa-solid fa-check text-[#006400] mt-1 shrink-0" aria-hidden="true"></i>
                    <span>{t("servicos.ops.transport.item4")}</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Card Complementar: Gerenciamento no Gerador -->
          <div class="lg:col-span-5 bg-white rounded-2xl border border-gray-200 shadow-xs p-6 sm:p-8 space-y-6">
            <div class="flex items-center gap-3 pb-4 border-b border-gray-100">
              <div class="w-10 h-10 rounded-lg bg-[#003300] text-[#a6d37e] flex items-center justify-center shrink-0">
                <i class="fa-solid fa-boxes-stacked" aria-hidden="true"></i>
              </div>
              <div>
                <h3 class="text-lg font-bold text-gray-900">{t("servicos.ops.managing.title")}</h3>
                <p class="text-xs text-gray-500">{t("servicos.ops.managing.subtitle")}</p>
              </div>
            </div>

            <p class="text-gray-700 text-sm leading-relaxed">
              {t("servicos.ops.managing.desc")}
            </p>

            <ul class="space-y-3 text-xs sm:text-sm text-gray-700">
              <li class="flex items-start gap-2">
                <i class="fa-solid fa-check text-[#006400] mt-1 shrink-0" aria-hidden="true"></i>
                <span>{t("servicos.ops.managing.item1")}</span>
              </li>
              <li class="flex items-start gap-2">
                <i class="fa-solid fa-check text-[#006400] mt-1 shrink-0" aria-hidden="true"></i>
                <span>{t("servicos.ops.managing.item2")}</span>
              </li>
              <li class="flex items-start gap-2">
                <i class="fa-solid fa-check text-[#006400] mt-1 shrink-0" aria-hidden="true"></i>
                <span>{t("servicos.ops.managing.item3")}</span>
              </li>
            </ul>

            <div class="bg-gray-50 p-4 rounded-xl border border-gray-200 text-xs text-gray-600 leading-relaxed">
              <strong class="font-semibold text-gray-900 block mb-1">{t("servicos.ops.managing.noteTitle")}</strong>
              {t("servicos.ops.managing.noteDesc")}
            </div>
          </div>
        </div>
      </div>

      <!-- FRENTE 2: Engenharia Consultiva e Licenciamento -->
      <div class="space-y-8">
        <div class="border-b border-gray-200 pb-4 max-w-3xl">
          <span class="text-xs font-bold uppercase tracking-wider text-[#006400]">
            {t("servicos.consulting.badge")}
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-[#003300] tracking-tight">
            {t("servicos.consulting.title")}
          </h2>
          <p class="text-sm text-gray-600 mt-1">
            {t("servicos.consulting.desc")}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Painel 1: Licenças e Órgãos -->
          <div class="bg-white rounded-2xl border border-gray-200 shadow-xs p-6 sm:p-8 space-y-6">
            <div class="flex items-center gap-3 pb-4 border-b border-gray-100">
              <div class="w-10 h-10 rounded-lg bg-[#003300] text-[#a6d37e] flex items-center justify-center shrink-0">
                <i class="fa-solid fa-file-contract" aria-hidden="true"></i>
              </div>
              <div>
                <h3 class="text-lg font-bold text-gray-900">{t("servicos.consulting.licensing.title")}</h3>
                <p class="text-xs text-gray-500">{t("servicos.consulting.licensing.subtitle")}</p>
              </div>
            </div>

            <p class="text-gray-700 text-sm leading-relaxed">
              {t("servicos.consulting.licensing.desc")}
            </p>

            <ul class="space-y-2.5 text-xs sm:text-sm text-gray-700">
              <li class="flex items-start gap-2">
                <i class="fa-solid fa-check text-[#006400] mt-1 shrink-0" aria-hidden="true"></i>
                <span>{t("servicos.consulting.licensing.item1")}</span>
              </li>
              <li class="flex items-start gap-2">
                <i class="fa-solid fa-check text-[#006400] mt-1 shrink-0" aria-hidden="true"></i>
                <span>{t("servicos.consulting.licensing.item2")}</span>
              </li>
              <li class="flex items-start gap-2">
                <i class="fa-solid fa-check text-[#006400] mt-1 shrink-0" aria-hidden="true"></i>
                <span>{t("servicos.consulting.licensing.item3")}</span>
              </li>
              <li class="flex items-start gap-2">
                <i class="fa-solid fa-check text-[#006400] mt-1 shrink-0" aria-hidden="true"></i>
                <span>{t("servicos.consulting.licensing.item4")}</span>
              </li>
            </ul>
          </div>

          <!-- Painel 2: Planos, Normas e Laudos -->
          <div class="bg-white rounded-2xl border border-gray-200 shadow-xs p-6 sm:p-8 space-y-6">
            <div class="flex items-center gap-3 pb-4 border-b border-gray-100">
              <div class="w-10 h-10 rounded-lg bg-[#003300] text-[#a6d37e] flex items-center justify-center shrink-0">
                <i class="fa-solid fa-book-bookmark" aria-hidden="true"></i>
              </div>
              <div>
                <h3 class="text-lg font-bold text-gray-900">{t("servicos.consulting.norms.title")}</h3>
                <p class="text-xs text-gray-500">{t("servicos.consulting.norms.subtitle")}</p>
              </div>
            </div>

            <p class="text-gray-700 text-sm leading-relaxed">
              {t("servicos.consulting.norms.desc")}
            </p>

            <ul class="space-y-2.5 text-xs sm:text-sm text-gray-700">
              <li class="flex items-start gap-2">
                <i class="fa-solid fa-check text-[#006400] mt-1 shrink-0" aria-hidden="true"></i>
                <span>{t("servicos.consulting.norms.item1")}</span>
              </li>
              <li class="flex items-start gap-2">
                <i class="fa-solid fa-check text-[#006400] mt-1 shrink-0" aria-hidden="true"></i>
                <span>{t("servicos.consulting.norms.item2")}</span>
              </li>
              <li class="flex items-start gap-2">
                <i class="fa-solid fa-check text-[#006400] mt-1 shrink-0" aria-hidden="true"></i>
                <span>{t("servicos.consulting.norms.item3")}</span>
              </li>
              <li class="flex items-start gap-2">
                <i class="fa-solid fa-check text-[#006400] mt-1 shrink-0" aria-hidden="true"></i>
                <span>{t("servicos.consulting.norms.item4")}</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Fechamento Único de Conversão -->
      <div class="bg-[#003300] text-white p-8 sm:p-10 rounded-2xl shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div class="space-y-1">
          <h3 class="text-xl font-bold text-white">
            {t("servicos.cta.title")}
          </h3>
          <p class="text-sm text-emerald-100/80">
            {t("servicos.cta.desc")}
          </p>
        </div>
        <a
          href="/contato"
          class="inline-flex items-center justify-center bg-[#006400] hover:bg-[#004d00] text-white font-bold text-sm px-6 py-3 rounded-lg shadow-sm hover:shadow transition-all shrink-0 focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#a6d37e]"
        >
          {t("cta.contact")}
        </a>
      </div>
    </div>
  </section>
</Layout>
