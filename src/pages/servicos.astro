---
import Layout from "../layouts/Layout.astro";
import { services } from "../data/services";
---

<Layout
  title="Serviços | Enfoque Ambiental"
  description="Serviços de coleta e transporte de resíduos, hidrojateamento, licenciamento CETESB e consultoria ambiental."
  currentPath="/servicos"
>
  <section class="bg-[#003300] text-white py-12 md:py-16 border-b border-emerald-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl space-y-2">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight">
          Nossos Serviços
        </h1>
        <p class="text-emerald-100/90 text-base sm:text-lg">
          Serviços de transporte de resíduos, consultoria técnica e gerenciamento ambiental.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 space-y-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {services.map((serv) => (
          <div class="bg-white rounded-2xl overflow-hidden border border-gray-200 shadow-xs flex flex-col justify-between">
            <div>
              <div class="h-44 overflow-hidden bg-gray-100 relative">
                <img
                  src={serv.image}
                  alt={serv.title}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
                <div class="absolute top-4 left-4 w-10 h-10 rounded-lg bg-[#003300] text-[#a6d37e] flex items-center justify-center shadow-md">
                  <i class={`${serv.icon} text-lg`} aria-hidden="true"></i>
                </div>
              </div>

              <div class="p-6 space-y-4">
                <h2 class="text-lg font-bold text-[#003300]">
                  {serv.title}
                </h2>
                <p class="text-gray-600 text-sm leading-relaxed">
                  {serv.description}
                </p>

                <div class="pt-2">
                  <h3 class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-2">Escopo Técnico:</h3>
                  <ul class="space-y-1.5 text-xs text-gray-700">
                    {serv.scope.map((item) => (
                      <li class="flex items-start gap-2">
                        <i class="fa-solid fa-check text-[#006400] mt-0.5" aria-hidden="true"></i>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>

            <div class="p-6 pt-0 mt-4">
              <a
                href="/contato"
                class="inline-flex items-center justify-center w-full bg-[#006400] hover:bg-[#004d00] text-white font-semibold text-sm py-2.5 rounded-lg transition-colors"
              >
                Fale Conosco
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
