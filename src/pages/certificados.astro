---
import Layout from "../layouts/Layout.astro";
import { certifications } from "../data/certifications";
---

<Layout
  title="Certificados e Licenças | Enfoque Ambiental"
  description="Consulte os certificados e licenças regulatórias da Enfoque Ambiental: CETESB, IBAMA, ANTT, AVCB e Alvará de Funcionamento."
  currentPath="/certificados"
>
  <section class="bg-[#003300] text-white py-12 md:py-16 border-b border-emerald-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl space-y-2">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight">
          Certificados e Licenças
        </h1>
        <p class="text-emerald-100/90 text-base sm:text-lg">
          Painel de conformidade regulatória perante os órgãos fiscalizadores para auditorias e homologação de fornecedores.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-gray-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 space-y-6">
      <div class="bg-white rounded-2xl border border-gray-200 shadow-xs divide-y divide-gray-200 overflow-hidden">
        {certifications.map((cert) => (
          <div class="p-6 sm:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 hover:bg-gray-50/50 transition-colors">
            <div class="flex items-start gap-5">
              <div class="w-24 h-16 rounded-xl bg-white border border-gray-200 p-2 flex items-center justify-center shrink-0 shadow-2xs">
                <img
                  src={cert.image}
                  alt={`Logotipo ${cert.name}`}
                  class="h-12 max-w-full object-contain"
                  loading="lazy"
                />
              </div>

              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-bold text-[#006400] uppercase tracking-wider">
                    {cert.name}
                  </span>
                  <span class="text-gray-300">•</span>
                  <span class="text-xs text-gray-500">
                    {cert.authority}
                  </span>
                </div>
                <h2 class="text-base sm:text-lg font-bold text-gray-900">
                  {cert.scope}
                </h2>
              </div>
            </div>

            <div class="flex flex-wrap sm:flex-nowrap items-center gap-2 w-full md:w-auto shrink-0 pt-2 md:pt-0">
              {cert.documents.map((doc) => (
                <a
                  href={doc.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-xs font-bold text-[#003300] hover:text-[#006400] bg-gray-100 hover:bg-emerald-50 border border-gray-200 px-4 py-2.5 rounded-lg transition-colors whitespace-nowrap focus-visible:ring-2 focus-visible:ring-[#006400] focus-visible:outline-hidden"
                >
                  <i class="fa-solid fa-file-pdf text-red-600 text-sm" aria-hidden="true"></i>
                  <span>{doc.title}</span>
                  <i class="fa-solid fa-arrow-up-right-from-square text-[10px] text-gray-400" aria-hidden="true"></i>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Fechamento para Homologação de Fornecedores -->
      <div class="bg-[#003300] text-white p-8 sm:p-10 rounded-2xl shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div class="space-y-1">
          <h2 class="text-xl font-bold text-white">
            Necessita de certidões adicionais para homologação?
          </h2>
          <p class="text-sm text-emerald-100/80">
            Fornecemos certidões negativas, comprovantes cadastrais e dados operacionais para o setor de compras da sua empresa.
          </p>
        </div>
        <a
          href="/contato"
          class="inline-flex items-center justify-center bg-[#006400] hover:bg-[#004d00] text-white font-bold text-sm px-6 py-3 rounded-lg shadow-sm hover:shadow transition-all shrink-0"
        >
          Fale Conosco
        </a>
      </div>
    </div>
  </section>
</Layout>
