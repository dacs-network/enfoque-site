---
import Layout from "../layouts/Layout.astro";
import HeroSlider from "../components/HeroSlider.astro";
import ServiceMatrix from "../components/ServiceMatrix.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title={t("home.meta.title")}
  description={t("home.meta.description")}
  currentPath="/"
>
  <HeroSlider />

  <!-- Credenciais Institucionais -->
  <section class="bg-[#003300] text-white py-6 border-b border-emerald-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-center sm:text-left">
        <div class="flex items-center gap-4 justify-center sm:justify-start">
          <div class="w-12 h-12 rounded-lg bg-emerald-900/60 flex items-center justify-center shrink-0 border border-emerald-700/40">
            <i class="fa-solid fa-calendar-check text-[#a6d37e] text-2xl" aria-hidden="true"></i>
          </div>
          <div>
            <div class="font-bold text-lg text-white tabular-nums">{t("home.stats.experience.title")}</div>
            <div class="text-xs text-emerald-200/80">{t("home.stats.experience.subtitle")}</div>
          </div>
        </div>

        <div class="flex items-center gap-4 justify-center sm:justify-start">
          <div class="w-12 h-12 rounded-lg bg-emerald-900/60 flex items-center justify-center shrink-0 border border-emerald-700/40">
            <i class="fa-solid fa-user-shield text-[#a6d37e] text-2xl" aria-hidden="true"></i>
          </div>
          <div>
            <div class="font-bold text-lg text-white">{t("home.stats.technical.title")}</div>
            <div class="text-xs text-emerald-200/80">{t("home.stats.technical.subtitle")}</div>
          </div>
        </div>

        <div class="flex items-center gap-4 justify-center sm:justify-start">
          <div class="w-12 h-12 rounded-lg bg-emerald-900/60 flex items-center justify-center shrink-0 border border-emerald-700/40">
            <i class="fa-solid fa-truck-fast text-[#a6d37e] text-2xl" aria-hidden="true"></i>
          </div>
          <div>
            <div class="font-bold text-lg text-white">{t("home.stats.fleet.title")}</div>
            <div class="text-xs text-emerald-200/80">{t("home.stats.fleet.subtitle")}</div>
          </div>
        </div>

        <div class="flex items-center gap-4 justify-center sm:justify-start">
          <div class="w-12 h-12 rounded-lg bg-emerald-900/60 flex items-center justify-center shrink-0 border border-emerald-700/40">
            <i class="fa-solid fa-shield-halved text-[#a6d37e] text-2xl" aria-hidden="true"></i>
          </div>
          <div>
            <div class="font-bold text-lg text-white">{t("home.stats.compliance.title")}</div>
            <div class="text-xs text-emerald-200/80">{t("home.stats.compliance.subtitle")}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- A Empresa (Quem Somos e Atuação) -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-6">
          <div class="space-y-3">
            <span class="text-xs font-bold uppercase tracking-wider text-[#006400]">
              {t("home.institutional.badge")}
            </span>
            <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#003300] tracking-tight leading-snug">
              {t("home.institutional.title")}
            </h2>
          </div>

          <p class="text-gray-700 text-base sm:text-lg leading-relaxed">
            {t("home.institutional.p1")}
          </p>

          <p class="text-gray-700 text-base sm:text-lg leading-relaxed">
            {t("home.institutional.p2")}
          </p>

          <div class="pt-2">
            <a
              href="/empresa"
              class="inline-flex items-center gap-2 text-sm sm:text-base font-semibold text-[#003300] hover:text-[#006400] group focus-visible:ring-2 focus-visible:ring-[#006400] rounded"
            >
              <span>{t("home.institutional.link")}</span>
              <i class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1" aria-hidden="true"></i>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-2xl overflow-hidden shadow-md border border-gray-200 bg-gray-100">
            <img
              src="/img/servico-transporte-residuo.webp"
              alt={t("home.hero.slide2.title")}
              class="w-full h-auto object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Serviços e Equipamentos -->
  <ServiceMatrix />
</Layout>
