---
import Layout from "../layouts/Layout.astro";

// Slides originais do site
const slides = [
  {
    image: "/img/slides/slide1.png",
    alt: "Serviços de Consultoria e Assessoria Ambiental",
    title: "Consultoria e Assessoria Ambiental Especializada",
    subtitle: "Licenciamento junto à CETESB, CADRI, IBAMA, DAEE e elaboração de normas e projetos técnicos.",
    href: "/servicos",
    cta: "Conhecer Consultoria",
  },
  {
    image: "/img/slides/slide2.png",
    alt: "Coleta e Transporte de Resíduos Perigosos e Não Perigosos",
    title: "Coleta e Transporte Seguro de Resíduos",
    subtitle: "Atendimento especializado a resíduos Classe I (perigosos) e Classe II, efluentes industriais e produtos químicos.",
    href: "/servicos",
    cta: "Ver Transporte de Resíduos",
  },
  {
    image: "/img/slides/slide3.png",
    alt: "Gerenciamento Global e Destinação de Resíduos",
    title: "Gerenciamento e Destinação Final Homologada",
    subtitle: "Rastreabilidade e conformidade integral com regulamentos e normas técnicas aplicáveis em vigor.",
    href: "/servicos",
    cta: "Serviços de Gerenciamento",
  },
];

// Principais serviços destacados (Original Box 2)
const featuredServices = [
  {
    icon: "fa-solid fa-boxes-stacked",
    title: "Gerenciamento de Resíduos",
    description: "Diagnóstico, classificação, acondicionamento, controle e destinação correta conforme as diretrizes ambientais vigentes.",
    href: "/servicos",
  },
  {
    icon: "fa-solid fa-truck-moving",
    title: "Coleta e Transporte de Resíduos",
    description: "Transporte com frota própria para resíduos industriais Classe I e II, efluentes líquidos e pronto atendimento a contingências.",
    href: "/servicos",
  },
  {
    icon: "fa-solid fa-file-signature",
    title: "Consultoria e Assessoria Ambiental",
    description: "Licenças prévias, de instalação e operação na CETESB, solicitação de CADRI, outorgas DAEE e cadastros federais no IBAMA.",
    href: "/servicos",
  },
  {
    icon: "fa-solid fa-book-bookmark",
    title: "Elaboração de Normas e Manuais",
    description: "Planos de Gerenciamento de Resíduos Sólidos (PGRS), planos de contingência e procedimentos operacionais padronizados.",
    href: "/servicos",
  },
];

// Equipamentos em destaque (Original Box 3)
const featuredEquipment = [
  {
    icon: "fa-solid fa-truck-ramp-box",
    name: "Caminhão Roll-On Roll-Off",
    use: "Transportes de carga a granel e resíduos industriais em caçambas específicas.",
  },
  {
    icon: "fa-solid fa-truck-moving",
    name: "Roll-On Roll-Off Romeu e Julieta",
    use: "Alta capacidade volumétrica de carga para grandes demandas industriais de resíduos sólidos.",
  },
  {
    icon: "fa-solid fa-truck-droplet",
    name: "Caminhão Tanque",
    use: "Transporte seguro e homologado de efluentes líquidos industriais para locais licenciados.",
  },
  {
    icon: "fa-solid fa-arrow-down-up-across-line",
    name: "Equipamento Auto Vácuo",
    use: "Sucção técnica e transporte de resíduos líquidos e pastosos acumulados em caixas e reservatórios.",
  },
  {
    icon: "fa-solid fa-layer-group",
    name: "Caminhão Plataforma",
    use: "Transporte seguro e estável de até 40 tambores de produtos químicos e resíduos perigosos.",
  },
  {
    icon: "fa-solid fa-water",
    name: "Caminhão com Hidrojateamento",
    use: "Desobstrução de redes industriais, canaletas e limpeza técnica de fossas sépticas.",
  },
];

// Certificações & Órgãos Reguladores
const certifications = [
  {
    name: "CETESB",
    image: "/img/logotipos/cetesb.jpg",
    details: "Certificado de Dispensa de Licença (CDL) e Licença de Operação",
  },
  {
    name: "IBAMA",
    image: "/img/logotipos/ibama.jpg",
    details: "Certificado de Regularidade e Autorização para Transporte de Cargas Perigosas",
  },
  {
    name: "ANTT",
    image: "/img/logotipos/antt.jpg",
    details: "Certificado e Registro Nacional de Transportadores Rodoviários de Carga (RNTRC)",
  },
  {
    name: "AVCB - Bombeiros",
    image: "/img/logotipos/avcb.jpg",
    details: "Auto de Vistoria do Corpo de Bombeiros atestando conformidade predial e segurança",
  },
  {
    name: "Alvará Municipal",
    image: "/img/logotipos/alvara.jpg",
    details: "Alvará de Funcionamento e Localização da Prefeitura Municipal de Araras",
  },
];
---

<Layout
  title="Enfoque Ambiental | Consultoria, Transporte e Engenharia Ambiental"
  description="A Enfoque Ambiental trabalha há mais de 10 anos ajudando empresas a solucionar problemas ambientais com coleta, transporte de resíduos e consultoria técnica."
  currentPath="/"
>
  <!-- 1. HERO SLIDESHOW SECTION -->
  <section class="relative bg-emerald-950 overflow-hidden" aria-label="Apresentação em Destaque">
    <!-- Carousel Wrapper -->
    <div id="hero-carousel" class="relative w-full overflow-hidden min-h-[400px] sm:min-h-[460px] md:min-h-[520px]">
      {slides.map((slide, index) => (
        <div
          class={`carousel-slide absolute inset-0 w-full h-full transition-opacity duration-700 ease-in-out flex items-center ${
            index === 0 ? "opacity-100 z-10" : "opacity-0 z-0 pointer-events-none"
          }`}
          data-slide-index={index}
        >
          <!-- Background Image with Gradient Overlay -->
          <div class="absolute inset-0">
            <img
              src={slide.image}
              alt={slide.alt}
              class="w-full h-full object-cover object-center filter brightness-90"
              loading={index === 0 ? "eager" : "lazy"}
            />
            <div class="absolute inset-0 bg-gradient-to-r from-[#003300]/95 via-[#003300]/80 to-transparent"></div>
          </div>

          <!-- Slide Text Content -->
          <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-12 md:py-20 w-full">
            <div class="max-w-2xl text-white space-y-4">
              <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#a6d37e]/20 text-[#a6d37e] text-xs sm:text-sm font-bold border border-[#a6d37e]/30">
                <i class="fa-solid fa-leaf" aria-hidden="true"></i>
                <span>Enfoque Ambiental • Engenharia & Gestão</span>
              </span>

              <h1 class="text-2xl sm:text-3xl md:text-5xl font-extrabold leading-tight text-white tracking-tight drop-shadow-xs">
                {slide.title}
              </h1>

              <p class="text-sm sm:text-base md:text-lg text-emerald-100/90 leading-relaxed drop-shadow-xs">
                {slide.subtitle}
              </p>

              <div class="pt-3 flex flex-wrap gap-3">
                <a
                  href={slide.href}
                  class="inline-flex items-center gap-2 bg-[#006400] hover:bg-[#004d00] text-white font-bold text-sm sm:text-base px-6 py-3 rounded-lg shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5"
                >
                  <span>{slide.cta}</span>
                  <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
                </a>

                <a
                  href="/contato"
                  class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white font-semibold text-sm sm:text-base px-5 py-3 rounded-lg border border-white/30 backdrop-blur-xs transition-colors"
                >
                  <i class="fa-solid fa-headset text-[#a6d37e]" aria-hidden="true"></i>
                  <span>Falar com Técnico</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}

      <!-- Carousel Navigation Buttons -->
      <button
        id="carousel-prev"
        type="button"
        class="absolute left-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-black/40 hover:bg-black/70 text-white flex items-center justify-center transition-colors backdrop-blur-xs focus:outline-hidden focus:ring-2 focus:ring-[#a6d37e]"
        aria-label="Slide anterior"
      >
        <i class="fa-solid fa-chevron-left text-base sm:text-lg" aria-hidden="true"></i>
      </button>

      <button
        id="carousel-next"
        type="button"
        class="absolute right-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-black/40 hover:bg-black/70 text-white flex items-center justify-center transition-colors backdrop-blur-xs focus:outline-hidden focus:ring-2 focus:ring-[#a6d37e]"
        aria-label="Próximo slide"
      >
        <i class="fa-solid fa-chevron-right text-base sm:text-lg" aria-hidden="true"></i>
      </button>

      <!-- Carousel Indicators -->
      <div class="absolute bottom-4 left-0 right-0 z-20 flex justify-center gap-2">
        {slides.map((_, index) => (
          <button
            type="button"
            class={`carousel-indicator w-3 h-3 rounded-full transition-all ${
              index === 0 ? "bg-[#a6d37e] scale-125" : "bg-white/50 hover:bg-white"
            }`}
            data-indicator-index={index}
            aria-label={`Ir para slide ${index + 1}`}
          ></button>
        ))}
      </div>
    </div>
  </section>

  <!-- 2. QUICK CREDIBILITY STRIP -->
  <section class="bg-[#003300] text-white py-6 border-b border-emerald-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-center sm:text-left">
        <div class="flex items-center gap-4 justify-center sm:justify-start">
          <div class="w-12 h-12 rounded-lg bg-emerald-900/60 flex items-center justify-center shrink-0 border border-emerald-700/40">
            <i class="fa-solid fa-calendar-check text-[#a6d37e] text-2xl" aria-hidden="true"></i>
          </div>
          <div>
            <div class="font-bold text-lg text-white">+10 Anos de Mercado</div>
            <div class="text-xs text-emerald-200/80">Experiência e tradição técnica</div>
          </div>
        </div>

        <div class="flex items-center gap-4 justify-center sm:justify-start">
          <div class="w-12 h-12 rounded-lg bg-emerald-900/60 flex items-center justify-center shrink-0 border border-emerald-700/40">
            <i class="fa-solid fa-shield-halved text-[#a6d37e] text-2xl" aria-hidden="true"></i>
          </div>
          <div>
            <div class="font-bold text-lg text-white">100% Homologada</div>
            <div class="text-xs text-emerald-200/80">CETESB, IBAMA, ANTT e AVCB</div>
          </div>
        </div>

        <div class="flex items-center gap-4 justify-center sm:justify-start">
          <div class="w-12 h-12 rounded-lg bg-emerald-900/60 flex items-center justify-center shrink-0 border border-emerald-700/40">
            <i class="fa-solid fa-truck-fast text-[#a6d37e] text-2xl" aria-hidden="true"></i>
          </div>
          <div>
            <div class="font-bold text-lg text-white">Frota Própria</div>
            <div class="text-xs text-emerald-200/80">Equipamentos de última geração</div>
          </div>
        </div>

        <div class="flex items-center gap-4 justify-center sm:justify-start">
          <div class="w-12 h-12 rounded-lg bg-emerald-900/60 flex items-center justify-center shrink-0 border border-emerald-700/40">
            <i class="fa-solid fa-user-shield text-[#a6d37e] text-2xl" aria-hidden="true"></i>
          </div>
          <div>
            <div class="font-bold text-lg text-white">Corpo Especializado</div>
            <div class="text-xs text-emerald-200/80">Engenharia e consultoria legal</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. QUEM SOMOS / INSTITUCIONAL (Original Box 1) -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Text Column -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[#bfdba7]/40 text-[#003300] font-bold text-sm">
            <i class="fa-solid fa-building text-[#006400]" aria-hidden="true"></i>
            <span>Quem Somos</span>
          </div>

          <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#003300] tracking-tight leading-snug">
            A Enfoque Ambiental trabalha há mais de 10 anos ajudando empresas a solucionar seus problemas ambientais.
          </h2>

          <p class="text-gray-700 text-base sm:text-lg leading-relaxed">
            Oferecemos serviços de coleta e transporte de resíduos, com equipamentos de última geração para atendimento do setor público ou privado.
          </p>

          <p class="text-gray-700 text-base sm:text-lg leading-relaxed font-medium">
            Trabalhamos em total conformidade com regulamentos e normas técnicas aplicáveis em vigor.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
            <div class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 border border-gray-100">
              <i class="fa-solid fa-circle-check text-[#006400] text-xl mt-0.5" aria-hidden="true"></i>
              <div>
                <h3 class="font-bold text-gray-900 text-sm">Responsabilidade Legal</h3>
                <p class="text-xs text-gray-600 mt-1">Conformidade total com a legislação ambiental estadual e federal vigente.</p>
              </div>
            </div>

            <div class="flex items-start gap-3 p-4 rounded-xl bg-gray-50 border border-gray-100">
              <i class="fa-solid fa-certificate text-[#006400] text-xl mt-0.5" aria-hidden="true"></i>
              <div>
                <h3 class="font-bold text-gray-900 text-sm">Rastreabilidade Total</h3>
                <p class="text-xs text-gray-600 mt-1">Garantia documental e destinação em áreas devidamente homologadas pela CETESB.</p>
              </div>
            </div>
          </div>

          <div class="pt-2">
            <a
              href="/empresa"
              class="inline-flex items-center gap-2 text-[#006400] hover:text-[#003300] font-bold text-base group"
            >
              <span>Conheça nossa trajetória e missão institucional</span>
              <i class="fa-solid fa-arrow-right text-sm transform group-hover:translate-x-1 transition-transform" aria-hidden="true"></i>
            </a>
          </div>
        </div>

        <!-- Visual Column / Real Service Image -->
        <div class="lg:col-span-5 relative">
          <div class="rounded-2xl overflow-hidden shadow-xl border-4 border-white bg-gray-100">
            <img
              src="/img/servico-transporte-residuo.jpg"
              alt="Operação de Coleta e Transporte de Resíduos da Enfoque Ambiental"
              class="w-full h-auto object-cover"
              loading="lazy"
            />
          </div>

          <!-- Highlight Card -->
          <div class="absolute -bottom-6 -left-4 sm:-left-6 bg-[#003300] text-white p-5 rounded-xl shadow-lg border border-emerald-800 max-w-xs">
            <div class="flex items-center gap-3">
              <i class="fa-solid fa-award text-[#a6d37e] text-3xl" aria-hidden="true"></i>
              <div>
                <p class="text-xl font-extrabold text-white">Segurança Técnica</p>
                <p class="text-xs text-emerald-200">Equipe qualificada e pátio próprio</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. SERVIÇOS EM DESTAQUE (Original Box 2) -->
  <section class="py-16 md:py-24 bg-gray-50 border-y border-gray-200" aria-labelledby="services-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16 space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[#bfdba7]/40 text-[#003300] font-bold text-sm">
          <i class="fa-solid fa-list-check text-[#006400]" aria-hidden="true"></i>
          <span>Atuação Completa</span>
        </div>
        <h2 id="services-heading" class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#003300] tracking-tight">
          Principais Serviços Oferecidos
        </h2>
        <p class="text-gray-600 text-base sm:text-lg">
          Atendemos empresas e indústrias de todos os portes com rigor técnico, pontualidade e documentação completa para auditorias.
        </p>
      </div>

      <!-- Services Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredServices.map((service) => (
          <div class="bg-white p-6 rounded-xl border border-gray-200/80 shadow-xs hover:shadow-md transition-all duration-200 flex flex-col justify-between group hover:border-[#98c571]">
            <div class="space-y-4">
              <div class="w-14 h-14 rounded-xl bg-[#003300]/10 flex items-center justify-center text-[#003300] group-hover:bg-[#003300] group-hover:text-white transition-colors duration-200">
                <i class={`${service.icon} text-2xl`} aria-hidden="true"></i>
              </div>
              <h3 class="text-xl font-bold text-gray-900 group-hover:text-[#003300] transition-colors">
                {service.title}
              </h3>
              <p class="text-gray-600 text-sm leading-relaxed">
                {service.description}
              </p>
            </div>

            <div class="pt-6 mt-4 border-t border-gray-100">
              <a
                href={service.href}
                class="inline-flex items-center gap-2 text-sm font-bold text-[#006400] hover:text-[#003300]"
              >
                <span>Saiba mais</span>
                <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Full Services Banner CTA -->
      <div class="mt-12 bg-white rounded-2xl p-6 sm:p-8 border border-gray-200 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="space-y-1 text-center sm:text-left">
          <h4 class="text-lg font-bold text-gray-900">
            Precisa de soluções em Consultoria, Licenciamento ou Transporte Especializado?
          </h4>
          <p class="text-sm text-gray-600">
            Consulte nossa relação completa de atividades e licenças operacionais.
          </p>
        </div>
        <a
          href="/servicos"
          class="shrink-0 inline-flex items-center gap-2 bg-[#006400] hover:bg-[#004d00] text-white font-bold px-6 py-3 rounded-lg shadow-xs hover:shadow transition-all"
        >
          <span>Ver Todos os Serviços</span>
          <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- 5. EQUIPAMENTOS DE ÚLTIMA GERAÇÃO (Original Box 3) -->
  <section class="py-16 md:py-24 bg-white" aria-labelledby="equipment-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-12 md:mb-16 space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[#bfdba7]/40 text-[#003300] font-bold text-sm">
          <i class="fa-solid fa-truck text-[#006400]" aria-hidden="true"></i>
          <span>Frota & Tecnologia</span>
        </div>
        <h2 id="equipment-heading" class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#003300] tracking-tight">
          Equipamentos de Última Geração
        </h2>
        <p class="text-gray-600 text-base sm:text-lg">
          Contamos com frota e maquinário preparados para atender com agilidade e total segurança técnica às demandas operacionais mais exigentes.
        </p>
      </div>

      <!-- Equipment Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredEquipment.map((eq) => (
          <div class="bg-gray-50 p-6 rounded-xl border border-gray-200 hover:border-[#98c571] hover:bg-white hover:shadow-md transition-all duration-200">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-lg bg-[#003300] text-[#a6d37e] flex items-center justify-center shrink-0">
                <i class={`${eq.icon} text-xl`} aria-hidden="true"></i>
              </div>
              <div class="space-y-1">
                <h3 class="text-lg font-bold text-gray-900">
                  {eq.name}
                </h3>
                <p class="text-sm text-gray-600 leading-relaxed">
                  {eq.use}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Full Equipment CTA -->
      <div class="text-center mt-10">
        <a
          href="/equipamentos"
          class="inline-flex items-center gap-2 bg-[#003300] hover:bg-[#002200] text-white font-bold px-8 py-3.5 rounded-lg shadow-xs hover:shadow transition-all"
        >
          <i class="fa-solid fa-truck-moving text-[#a6d37e]" aria-hidden="true"></i>
          <span>Conhecer Todos os Equipamentos Utilizados</span>
          <i class="fa-solid fa-arrow-right text-xs" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- 6. CERTIFICADOS & CONFORMIDADE REGULATÓRIA -->
  <section class="py-16 md:py-20 bg-gray-50 border-t border-gray-200" aria-labelledby="certs-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[#bfdba7]/40 text-[#003300] font-bold text-sm">
          <i class="fa-solid fa-stamp text-[#006400]" aria-hidden="true"></i>
          <span>Segurança Jurídica</span>
        </div>
        <h2 id="certs-heading" class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#003300] tracking-tight">
          Certificados, Licenças e Homologações
        </h2>
        <p class="text-gray-600 text-sm sm:text-base">
          Trabalhe com a certeza da conformidade. Mantemos regularidade permanente perante os principais órgãos fiscalizadores.
        </p>
      </div>

      <!-- Certifications Cards Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-6">
        {certifications.map((cert) => (
          <div class="bg-white p-4 sm:p-5 rounded-xl border border-gray-200 shadow-xs flex flex-col items-center text-center space-y-3 hover:shadow-md transition-shadow">
            <div class="h-16 flex items-center justify-center">
              <img
                src={cert.image}
                alt={`Certificado ${cert.name}`}
                class="max-h-14 max-w-full object-contain filter hover:brightness-105 transition-all"
                loading="lazy"
              />
            </div>
            <div class="w-full pt-2 border-t border-gray-100">
              <span class="font-bold text-sm sm:text-base text-gray-900 block">{cert.name}</span>
              <span class="text-xs text-gray-500 line-clamp-2 mt-0.5">{cert.details}</span>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-8">
        <a
          href="/certificados"
          class="inline-flex items-center gap-2 text-sm font-bold text-[#006400] hover:text-[#003300] hover:underline"
