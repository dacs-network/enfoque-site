    title: "Consultoria e Assessoria Ambiental",
    subtitle: "Licenciamento junto à CETESB, CADRI, IBAMA, DAEE e elaboração de normas e projetos técnicos.",
    href: "/contato",
  },
  {
    image: "/img/slides/slide2.png",
    alt: "Coleta e Transporte de Resíduos",
    title: "Coleta e Transporte de Resíduos",
    subtitle: "Atendimento a resíduos Classe I e Classe II, efluentes industriais e acidentes com produtos químicos.",
    href: "/contato",
  },
  {
    image: "/img/slides/slide3.png",
    alt: "Gerenciamento de Resíduos",
    title: "Gerenciamento de Resíduos",
    subtitle: "Conformidade com regulamentos e normas técnicas aplicáveis em vigor.",
    href: "/contato",
  },
];

// Principais serviços (conteudo.md 2.1)
const featuredServices = [
  {
    icon: "fa-solid fa-boxes-stacked",
    title: "Gerenciamento de Resíduos",
    description: "Classificação, acondicionamento, controle e destinação correta de resíduos industriais.",
    href: "/servicos",
  },
  {
    icon: "fa-solid fa-truck-moving",
    title: "Coleta e Transporte de Resíduos",
    description: "Transporte de resíduos Classe I (perigosos) e Classe II, efluentes industriais e caçambas.",
    href: "/servicos",
  },
  {
    icon: "fa-solid fa-file-signature",
    title: "Consultoria e Assessoria Ambiental",
    description: "Licenciamento ambiental e CADRI junto à CETESB, cadastros no IBAMA e outorgas DAEE.",
    href: "/servicos",
  },
  {
    icon: "fa-solid fa-book-bookmark",
    title: "Elaboração de Normas e Manuais",
    description: "Planos de Gerenciamento de Resíduos Sólidos (PGRS) e documentação técnica para transporte.",
    href: "/servicos",
  },
];

// Equipamentos (conteudo.md 2.5)
const featuredEquipment = [
  {
    icon: "fa-solid fa-truck-ramp-box",
    name: "Caminhão Roll-On Roll-Off",
    use: "Transportes de carga a granel e resíduos industriais.",
  },
  {
    icon: "fa-solid fa-truck-moving",
    name: "Caminhão Roll-On Roll-Off Romeu e Julieta",
    use: "Transportes de carga a granel e resíduos industriais.",
  },
  {
    icon: "fa-solid fa-truck-droplet",
    name: "Caminhão Tanque",
    use: "Transportes de efluentes industriais.",
  },
  {
    icon: "fa-solid fa-arrow-down-up-across-line",
    name: "Caminhão com Equipamento Auto Vácuo",
    use: "Transportes de resíduos líquidos.",
  },
  {
    icon: "fa-solid fa-layer-group",
    name: "Caminhão Plataforma",
    use: "Transportes de até 40 tambores.",
  },
  {
    icon: "fa-solid fa-water",
    name: "Caminhão com Hidrojateamento",
    use: "Limpeza de fossa séptica.",
  },
];

// Certificados (conteudo.md 2.6)
const certifications = [
  {
    name: "CETESB",
    image: "/img/logotipos/cetesb.jpg",
    details: "Certificado de Dispensa de Licença (CDL) e Licença de Operação",
  },
  {
    name: "IBAMA",
    image: "/img/logotipos/ibama.jpg",
    details: "Certificado de Regularidade e Transporte de Produtos Perigosos",
  },
  {
    name: "ANTT",
    image: "/img/logotipos/antt.jpg",
    details: "Certificado e Registro Nacional de Transportadores Rodoviários (RNTRC)",
  },
  {
    name: "AVCB",
    image: "/img/logotipos/avcb.jpg",
    details: "Auto de Vistoria do Corpo de Bombeiros",
  },
  {
    name: "Alvará",
    image: "/img/logotipos/alvara.jpg",
    details: "Alvará de Funcionamento e Localização",
  },
];
---

<Layout
  title="Enfoque Ambiental | Coleta, Transporte e Consultoria Ambiental"
  description="A Enfoque Ambiental trabalha há mais de 10 anos oferecendo serviços de coleta e transporte de resíduos, consultoria técnica e licenciamento CETESB em Araras e região."
  currentPath="/"
>
  <!-- 1. HERO SLIDESHOW -->
  <section class="relative bg-emerald-950 overflow-hidden" aria-label="Slideshow">
    <div id="hero-carousel" class="relative w-full overflow-hidden min-h-[380px] sm:min-h-[440px] md:min-h-[500px]">
      {slides.map((slide, index) => (
        <div
          class={`carousel-slide absolute inset-0 w-full h-full transition-opacity duration-700 ease-in-out flex items-center ${
            index === 0 ? "opacity-100 z-10" : "opacity-0 z-0 pointer-events-none"
          }`}
          data-slide-index={index}
        >
          <div class="absolute inset-0">
            <img
              src={slide.image}
              alt={slide.alt}
              class="w-full h-full object-cover object-center filter brightness-90"
              loading={index === 0 ? "eager" : "lazy"}
            />
            <div class="absolute inset-0 bg-gradient-to-r from-[#003300]/95 via-[#003300]/80 to-transparent"></div>
          </div>

          <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-12 md:py-20 w-full">
            <div class="max-w-2xl text-white space-y-4">
              <h1 class="text-2xl sm:text-3xl md:text-5xl font-extrabold leading-tight text-white tracking-tight">
                {slide.title}
              </h1>

              <p class="text-sm sm:text-base md:text-lg text-emerald-100/90 leading-relaxed">
                {slide.subtitle}
              </p>

              <div class="pt-2">
                <a
                  href="/contato"
                  class="inline-flex items-center gap-2 bg-[#006400] hover:bg-[#004d00] text-white font-bold text-sm sm:text-base px-6 py-3 rounded-lg shadow-sm hover:shadow transition-all"
                >
                  <i class="fa-regular fa-comment-dots text-[#a6d37e]" aria-hidden="true"></i>
                  <span>Fale Conosco</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}

      <!-- Carousel Navigation Buttons -->
      <button
        id="carousel-prev"
        type="button"
        class="absolute left-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-black/40 hover:bg-black/70 text-white flex items-center justify-center transition-colors backdrop-blur-xs"
        aria-label="Slide anterior"
      >
        <i class="fa-solid fa-chevron-left text-base sm:text-lg" aria-hidden="true"></i>
      </button>

      <button
        id="carousel-next"
        type="button"
        class="absolute right-3 top-1/2 -translate-y-1/2 z-20 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-black/40 hover:bg-black/70 text-white flex items-center justify-center transition-colors backdrop-blur-xs"
        aria-label="Próximo slide"
      >
        <i class="fa-solid fa-chevron-right text-base sm:text-lg" aria-hidden="true"></i>
      </button>

      <!-- Carousel Indicators -->
      <div class="absolute bottom-4 left-0 right-0 z-20 flex justify-center gap-2">
        {slides.map((_, index) => (
          <button
            type="button"
            class={`carousel-indicator w-3 h-3 rounded-full transition-all ${
              index === 0 ? "bg-[#a6d37e] scale-125" : "bg-white/50 hover:bg-white"
            }`}
            data-indicator-index={index}
            aria-label={`Ir para slide ${index + 1}`}
          ></button>
        ))}
      </div>
    </div>
  </section>

  <!-- 2. INFORMAÇÕES OPERACIONAIS -->
  <section class="bg-[#003300] text-white py-6 border-b border-emerald-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-center sm:text-left">
        <div class="flex items-center gap-4 justify-center sm:justify-start">
          <div class="w-12 h-12 rounded-lg bg-emerald-900/60 flex items-center justify-center shrink-0 border border-emerald-700/40">
            <i class="fa-solid fa-calendar-check text-[#a6d37e] text-2xl" aria-hidden="true"></i>
          </div>
          <div>
            <div class="font-bold text-lg text-white">+10 Anos de Atuação</div>
            <div class="text-xs text-emerald-200/80">Sede e pátio em Araras/SP</div>
          </div>
        </div>

        <div class="flex items-center gap-4 justify-center sm:justify-start">
          <div class="w-12 h-12 rounded-lg bg-emerald-900/60 flex items-center justify-center shrink-0 border border-emerald-700/40">
            <i class="fa-solid fa-shield-halved text-[#a6d37e] text-2xl" aria-hidden="true"></i>
          </div>
          <div>
            <div class="font-bold text-lg text-white">Licenciamento</div>
            <div class="text-xs text-emerald-200/80">CETESB, IBAMA e ANTT</div>
          </div>
        </div>

        <div class="flex items-center gap-4 justify-center sm:justify-start">
          <div class="w-12 h-12 rounded-lg bg-emerald-900/60 flex items-center justify-center shrink-0 border border-emerald-700/40">
            <i class="fa-solid fa-truck-fast text-[#a6d37e] text-2xl" aria-hidden="true"></i>
          </div>
          <div>
            <div class="font-bold text-lg text-white">Frota Própria</div>
            <div class="text-xs text-emerald-200/80">Veículos coletores e transportadores</div>
          </div>
        </div>

        <div class="flex items-center gap-4 justify-center sm:justify-start">
          <div class="w-12 h-12 rounded-lg bg-emerald-900/60 flex items-center justify-center shrink-0 border border-emerald-700/40">
            <i class="fa-solid fa-user-shield text-[#a6d37e] text-2xl" aria-hidden="true"></i>
          </div>
          <div>
            <div class="font-bold text-lg text-white">Corpo Técnico</div>
            <div class="text-xs text-emerald-200/80">Engenharia e consultoria ambiental</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. QUEM SOMOS (conteudo.md 2.1 Bloco 1) -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Text Column -->
        <div class="lg:col-span-7 space-y-6">
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#003300] tracking-tight leading-snug">
            A Enfoque Ambiental trabalha há mais de 10 anos ajudando empresas a solucionar seus problemas ambientais.
          </h2>

          <p class="text-gray-700 text-base sm:text-lg leading-relaxed">
            Oferecemos serviços de coleta e transporte de resíduos, com equipamentos de última geração para atendimento do setor público ou privado.
          </p>

          <p class="text-gray-700 text-base sm:text-lg leading-relaxed">
            Trabalhamos em total conformidade com regulamentos e normas técnicas aplicáveis em vigor.
          </p>

          <div class="pt-2">
            <a
              href="/contato"
              class="inline-flex items-center gap-2 bg-[#006400] hover:bg-[#004d00] text-white font-bold text-sm sm:text-base px-6 py-3 rounded-lg shadow-sm hover:shadow transition-all"
            >
              <i class="fa-regular fa-comment-dots text-[#a6d37e]" aria-hidden="true"></i>
              <span>Fale Conosco</span>
            </a>
          </div>
        </div>

        <!-- Real Image -->
        <div class="lg:col-span-5">
          <div class="rounded-2xl overflow-hidden shadow-md border border-gray-200 bg-gray-100">
            <img
              src="/img/servico-transporte-residuo.jpg"
              alt="Coleta e Transporte de Resíduos Enfoque Ambiental"
              class="w-full h-auto object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. SERVIÇOS (conteudo.md 2.1 Bloco 2) -->
  <section class="py-16 md:py-20 bg-gray-50 border-y border-gray-200" aria-labelledby="services-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl mb-12 space-y-2">
        <h2 id="services-heading" class="text-2xl sm:text-3xl font-extrabold text-[#003300] tracking-tight">
          Principais Serviços Oferecidos
        </h2>
        <p class="text-gray-600 text-base">
          Entre os principais serviços oferecidos pela Enfoque Ambiental estão:
        </p>
      </div>

      <!-- Services Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredServices.map((service) => (
          <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-xs flex flex-col justify-between hover:border-[#98c571] transition-colors">
            <div class="space-y-4">
              <div class="w-12 h-12 rounded-xl bg-[#003300]/10 flex items-center justify-center text-[#003300]">
                <i class={`${service.icon} text-xl`} aria-hidden="true"></i>
              </div>
              <h3 class="text-lg font-bold text-gray-900">
                {service.title}
              </h3>
              <p class="text-gray-600 text-sm leading-relaxed">
                {service.description}
              </p>
            </div>

            <div class="pt-4 mt-4 border-t border-gray-100">
              <a
                href={service.href}
                class="inline-flex items-center gap-1.5 text-xs font-bold text-[#006400] hover:text-[#003300]"
              >
                <span>Conhecer detalhes</span>
                <i class="fa-solid fa-chevron-right text-[10px]" aria-hidden="true"></i>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. EQUIPAMENTOS (conteudo.md 2.1 Bloco 3 & 2.5) -->
  <section class="py-16 md:py-20 bg-white" aria-labelledby="equipment-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl mb-12 space-y-2">
        <h2 id="equipment-heading" class="text-2xl sm:text-3xl font-extrabold text-[#003300] tracking-tight">
          Nossos Equipamentos
        </h2>
        <p class="text-gray-600 text-base">
          A Enfoque Ambiental conta com equipamentos para atendimento do setor público e privado:
        </p>
      </div>

      <!-- Equipment Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredEquipment.map((eq) => (
          <div class="bg-gray-50 p-6 rounded-xl border border-gray-200">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-lg bg-[#003300] text-[#a6d37e] flex items-center justify-center shrink-0">
                <i class={`${eq.icon} text-lg`} aria-hidden="true"></i>
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-gray-900">
                  {eq.name}
                </h3>
                <p class="text-sm text-gray-600 leading-relaxed">
                  {eq.use}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. CERTIFICADOS (conteudo.md 2.6) -->
  <section class="py-16 md:py-20 bg-gray-50 border-t border-gray-200" aria-labelledby="certs-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl mb-10 space-y-2">
        <h2 id="certs-heading" class="text-2xl sm:text-3xl font-extrabold text-[#003300] tracking-tight">
          Certificados e Licenças
        </h2>
        <p class="text-gray-600 text-sm sm:text-base">
          Regularidade perante os órgãos fiscalizadores aplicáveis em vigor.
        </p>
      </div>

      <!-- Certifications Cards Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-6">
        {certifications.map((cert) => (
          <div class="bg-white p-4 sm:p-5 rounded-xl border border-gray-200 shadow-xs flex flex-col items-center text-center space-y-3">
            <div class="h-14 flex items-center justify-center">
              <img
                src={cert.image}
                alt={`Certificado ${cert.name}`}
                class="max-h-12 max-w-full object-contain"
                loading="lazy"
              />
            </div>
            <div class="w-full pt-2 border-t border-gray-100">
              <span class="font-bold text-sm text-gray-900 block">{cert.name}</span>
              <span class="text-xs text-gray-500 line-clamp-2 mt-0.5">{cert.details}</span>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-6">
        <a
          href="/certificados"
          class="inline-flex items-center gap-1.5 text-xs font-bold text-[#006400] hover:text-[#003300]"
        >
          <span>Visualizar documentação</span>
          <i class="fa-solid fa-chevron-right text-[10px]" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- 7. FALE CONOSCO -->
  <section class="py-14 md:py-16 bg-[#003300] text-white" aria-labelledby="cta-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-2 text-center md:text-left">
          <h2 id="cta-heading" class="text-2xl sm:text-3xl font-extrabold text-white">
            Fale Conosco
          </h2>
          <p class="text-emerald-100/90 text-sm sm:text-base max-w-2xl">
            Entre em contato para coleta de resíduos, serviços de transporte ou consultoria ambiental.
          </p>
        </div>

        <div class="flex flex-wrap gap-4 items-center justify-center">
          <a
            href="/contato"
            class="inline-flex items-center gap-2 bg-[#006400] hover:bg-[#004d00] text-white font-bold text-base px-6 py-3 rounded-lg shadow-sm transition-colors"
          >
            <i class="fa-regular fa-comment-dots text-[#a6d37e]" aria-hidden="true"></i>
            <span>Fale Conosco</span>
          </a>
          <a
            href="tel:1935417975"
            class="inline-flex items-center gap-2 text-emerald-100 hover:text-white text-base font-semibold px-4 py-3"
          >
            <i class="fa-solid fa-phone text-[#a6d37e]" aria-hidden="true"></i>
            <span>(19) 3541 7975</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Hero Carousel Controller (Vanilla JavaScript)
  const slides = document.querySelectorAll(".carousel-slide");
  const indicators = document.querySelectorAll(".carousel-indicator");
  const prevBtn = document.getElementById("carousel-prev");
  const nextBtn = document.getElementById("carousel-next");

  let currentSlide = 0;
  let autoplayTimer: number | null = null;
  const slideCount = slides.length;

  function showSlide(index: number) {
    if (slideCount === 0) return;

    currentSlide = (index + slideCount) % slideCount;

    slides.forEach((slide, i) => {
      if (i === currentSlide) {
        slide.classList.remove("opacity-0", "z-0", "pointer-events-none");
        slide.classList.add("opacity-100", "z-10");
      } else {
        slide.classList.remove("opacity-100", "z-10");
        slide.classList.add("opacity-0", "z-0", "pointer-events-none");
      }
    });

    indicators.forEach((ind, i) => {
      if (i === currentSlide) {
        ind.classList.remove("bg-white/50");
        ind.classList.add("bg-[#a6d37e]", "scale-125");
      } else {
        ind.classList.remove("bg-[#a6d37e]", "scale-125");
        ind.classList.add("bg-white/50");
      }
    });
  }

  function nextSlide() {
    showSlide(currentSlide + 1);
  }

  function prevSlide() {
    showSlide(currentSlide - 1);
  }

  function resetAutoplay() {
    if (autoplayTimer) clearInterval(autoplayTimer);
    autoplayTimer = window.setInterval(nextSlide, 7000);
  }

  if (prevBtn && nextBtn && slides.length > 0) {
    nextBtn.addEventListener("click", () => {
      nextSlide();
      resetAutoplay();
    });

    prevBtn.addEventListener("click", () => {
      prevSlide();
      resetAutoplay();
    });

    indicators.forEach((ind) => {
      ind.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLElement;
        const targetIndex = Number(target.getAttribute("data-indicator-index"));
        if (!isNaN(targetIndex)) {
          showSlide(targetIndex);
          resetAutoplay();
        }
      });
    });

    // Iniciar autoplay
    resetAutoplay();
  }
</script>
