---
import Layout from "../layouts/Layout.astro";
import { company } from "../data/company";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title={t("empresa.meta.title")}
  description={t("empresa.meta.description")}
  currentPath="/empresa"
>
  <section class="bg-[#003300] text-white py-12 md:py-16 border-b border-emerald-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl space-y-2">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight">
          {t("empresa.hero.title")}
        </h1>
        <p class="text-emerald-100/90 text-base sm:text-lg">
          {t("empresa.hero.subtitle")}
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 space-y-12">
      <!-- Visão Geral -->
      <div class="space-y-4">
        <span class="text-xs font-bold uppercase tracking-wider text-[#006400]">
          {t("empresa.profile.badge")}
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#003300] tracking-tight">
          {t("empresa.profile.title")}
        </h2>
        <p class="text-gray-700 text-base sm:text-lg leading-relaxed">
          {t("empresa.profile.p1")}
        </p>
        <p class="text-gray-700 text-base sm:text-lg leading-relaxed">
          {t("empresa.profile.p2")}
        </p>
      </div>

      <!-- Pilares Técnicos -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4">
        <div class="bg-gray-50 p-6 rounded-2xl border border-gray-200 space-y-3">
          <div class="w-10 h-10 rounded-lg bg-[#003300] text-[#a6d37e] flex items-center justify-center">
            <i class="fa-solid fa-scale-balanced" aria-hidden="true"></i>
          </div>
          <h3 class="text-base font-bold text-gray-900">{t("empresa.pillars.normative.title")}</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            {t("empresa.pillars.normative.desc")}
          </p>
        </div>

        <div class="bg-gray-50 p-6 rounded-2xl border border-gray-200 space-y-3">
          <div class="w-10 h-10 rounded-lg bg-[#003300] text-[#a6d37e] flex items-center justify-center">
            <i class="fa-solid fa-route" aria-hidden="true"></i>
          </div>
          <h3 class="text-base font-bold text-gray-900">{t("empresa.pillars.traceability.title")}</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            {t("empresa.pillars.traceability.desc")}
          </p>
        </div>

        <div class="bg-gray-50 p-6 rounded-2xl border border-gray-200 space-y-3">
          <div class="w-10 h-10 rounded-lg bg-[#003300] text-[#a6d37e] flex items-center justify-center">
            <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
          </div>
          <h3 class="text-base font-bold text-gray-900">{t("empresa.pillars.safety.title")}</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            {t("empresa.pillars.safety.desc")}
          </p>
        </div>
      </div>

      <!-- Estrutura Operacional -->
      <div class="bg-gray-50 p-8 rounded-2xl border border-gray-200 space-y-4">
        <h3 class="text-xl font-bold text-[#003300]">
          {t("empresa.structure.title")}
        </h3>
        <p class="text-gray-700 text-sm sm:text-base leading-relaxed">
          {t("empresa.structure.desc")}
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 text-sm text-gray-700">
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-location-dot text-[#006400]" aria-hidden="true"></i>
            <span>{company.address.street} • {company.address.district} • {company.address.city}/{company.address.state}</span>
          </div>
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-phone text-[#006400]" aria-hidden="true"></i>
            <span>{company.phones.map((p) => p.display).join(" • ")}</span>
          </div>
        </div>
      </div>

      <!-- Fechamento -->
      <div class="pt-6 border-t border-gray-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h4 class="text-lg font-bold text-gray-900">{t("empresa.cta.title")}</h4>
          <p class="text-sm text-gray-600">{t("empresa.cta.desc")}</p>
        </div>
        <a
          href="/contato"
          class="inline-flex items-center justify-center bg-[#006400] hover:bg-[#004d00] text-white font-bold text-sm px-6 py-3 rounded-lg shadow-sm hover:shadow transition-all shrink-0 focus-visible:ring-2 focus-visible:ring-[#006400]"
        >
          {t("cta.contact")}
        </a>
      </div>
    </div>
  </section>
</Layout>
