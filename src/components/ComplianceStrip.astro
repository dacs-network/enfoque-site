---
import { certifications } from "../data/certifications";

interface Props {
  showTitle?: boolean;
}

const { showTitle = true } = Astro.props;
---

<section class="py-16 md:py-20 bg-gray-50 border-t border-gray-200" aria-labelledby="certs-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    {showTitle && (
      <div class="max-w-3xl mb-10 space-y-2">
        <h2 id="certs-heading" class="text-2xl sm:text-3xl font-extrabold text-[#003300] tracking-tight">
          Certificados e Licenças
        </h2>
        <p class="text-gray-600 text-sm sm:text-base">
          Regularidade e licenças ativas perante os órgãos fiscalizadores vigentes:
        </p>
      </div>
    )}

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-6">
      {certifications.map((cert) => (
        <div class="bg-white p-4 sm:p-5 rounded-xl border border-gray-200 shadow-xs flex flex-col items-center text-center space-y-3">
          <div class="h-14 flex items-center justify-center">
            <img
              src={cert.image}
              alt={`Certificado ${cert.name}`}
              class="max-h-12 max-w-full object-contain"
              loading="lazy"
            />
          </div>
          <div class="w-full pt-2 border-t border-gray-100">
            <span class="font-bold text-sm text-gray-900 block">{cert.name}</span>
            <span class="text-xs text-gray-500 line-clamp-2 mt-0.5">{cert.scope}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-8 text-center sm:text-left">
      <a
        href="/certificados"
        class="inline-flex items-center gap-1.5 text-xs font-bold text-[#006400] hover:text-[#003300]"
      >
        <span>Visualizar e baixar todos os documentos comprobatórios</span>
        <i class="fa-solid fa-chevron-right text-[10px]" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</section>
