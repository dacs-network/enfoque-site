---
import { company } from "../data/company";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="bg-[#003300] text-white border-t-4 border-[#006400]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      <!-- Col 1: Institucional -->
      <div class="space-y-4">
        <a href="/" class="inline-block" aria-label={t("site.name")}>
          <img
            src="/img/logo-white.png"
            alt={company.name}
            width="220"
            height="90"
            class="h-12 sm:h-14 w-auto object-contain"
            loading="lazy"
          />
        </a>
        <p class="text-emerald-100/90 text-sm leading-relaxed">
          {company.description}
        </p>
        <div class="flex items-center gap-3 pt-2">
          <a
            href="https://facebook.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-emerald-950 flex items-center justify-center text-emerald-200 hover:text-white hover:bg-[#006400] transition-colors focus-visible:ring-2 focus-visible:ring-[#a6d37e]"
            aria-label="Facebook"
          >
            <i class="fa-brands fa-facebook-f text-base" aria-hidden="true"></i>
          </a>
          <a
            href={`mailto:${company.email}`}
            class="w-9 h-9 rounded-full bg-emerald-950 flex items-center justify-center text-emerald-200 hover:text-white hover:bg-[#006400] transition-colors focus-visible:ring-2 focus-visible:ring-[#a6d37e]"
            aria-label={t("footer.emailLabel")}
          >
            <i class="fa-solid fa-envelope text-base" aria-hidden="true"></i>
          </a>
          <a
            href="https://wa.me/551935417975"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-emerald-950 flex items-center justify-center text-emerald-200 hover:text-white hover:bg-[#006400] transition-colors focus-visible:ring-2 focus-visible:ring-[#a6d37e]"
            aria-label="WhatsApp"
          >
            <i class="fa-brands fa-whatsapp text-base" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <!-- Col 2: Navegação -->
      <div>
        <h4 class="text-base font-bold text-white uppercase tracking-wider mb-4 pb-2 border-b border-emerald-900 flex items-center gap-2">
          <i class="fa-solid fa-bars text-[#a6d37e]" aria-hidden="true"></i>
          <span>{t("footer.navTitle")}</span>
        </h4>
        <ul class="space-y-2.5 text-sm text-emerald-100/80">
          <li>
            <a href="/" class="hover:text-white hover:translate-x-1 inline-flex items-center transition-all focus-visible:ring-2 focus-visible:ring-[#a6d37e] rounded">
              <i class="fa-solid fa-chevron-right text-xs text-[#a6d37e] mr-1.5" aria-hidden="true"></i> {t("nav.home")}
            </a>
          </li>
          <li>
            <a href="/empresa" class="hover:text-white hover:translate-x-1 inline-flex items-center transition-all focus-visible:ring-2 focus-visible:ring-[#a6d37e] rounded">
              <i class="fa-solid fa-chevron-right text-xs text-[#a6d37e] mr-1.5" aria-hidden="true"></i> {t("nav.empresa")}
            </a>
          </li>
          <li>
            <a href="/servicos" class="hover:text-white hover:translate-x-1 inline-flex items-center transition-all focus-visible:ring-2 focus-visible:ring-[#a6d37e] rounded">
              <i class="fa-solid fa-chevron-right text-xs text-[#a6d37e] mr-1.5" aria-hidden="true"></i> {t("nav.servicos")}
            </a>
          </li>
          <li>
            <a href="/equipamentos" class="hover:text-white hover:translate-x-1 inline-flex items-center transition-all focus-visible:ring-2 focus-visible:ring-[#a6d37e] rounded">
              <i class="fa-solid fa-chevron-right text-xs text-[#a6d37e] mr-1.5" aria-hidden="true"></i> {t("nav.equipamentos")}
            </a>
          </li>
          <li>
            <a href="/certificados" class="hover:text-white hover:translate-x-1 inline-flex items-center transition-all focus-visible:ring-2 focus-visible:ring-[#a6d37e] rounded">
              <i class="fa-solid fa-chevron-right text-xs text-[#a6d37e] mr-1.5" aria-hidden="true"></i> {t("nav.certificados")}
            </a>
          </li>
          <li>
            <a href="/contato" class="hover:text-white hover:translate-x-1 inline-flex items-center transition-all focus-visible:ring-2 focus-visible:ring-[#a6d37e] rounded">
              <i class="fa-solid fa-chevron-right text-xs text-[#a6d37e] mr-1.5" aria-hidden="true"></i> {t("nav.contato")}
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Serviços -->
      <div>
        <h4 class="text-base font-bold text-white uppercase tracking-wider mb-4 pb-2 border-b border-emerald-900 flex items-center gap-2">
          <i class="fa-solid fa-truck-droplet text-[#a6d37e]" aria-hidden="true"></i>
          <span>{t("footer.servicesTitle")}</span>
        </h4>
        <ul class="space-y-2.5 text-sm text-emerald-100/80">
          <li>
            <a href="/servicos" class="hover:text-white transition-colors focus-visible:ring-2 focus-visible:ring-[#a6d37e] rounded">
              • {t("servicos.ops.transport.title")}
            </a>
          </li>
          <li>
            <a href="/servicos" class="hover:text-white transition-colors focus-visible:ring-2 focus-visible:ring-[#a6d37e] rounded">
              • {t("servicos.ops.managing.title")}
            </a>
          </li>
          <li>
            <a href="/servicos" class="hover:text-white transition-colors focus-visible:ring-2 focus-visible:ring-[#a6d37e] rounded">
              • {t("servicos.consulting.licensing.title")}
            </a>
          </li>
          <li>
            <a href="/servicos" class="hover:text-white transition-colors focus-visible:ring-2 focus-visible:ring-[#a6d37e] rounded">
              • {t("servicos.consulting.norms.title")}
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Contato -->
      <div>
        <h4 class="text-base font-bold text-white uppercase tracking-wider mb-4 pb-2 border-b border-emerald-900 flex items-center gap-2">
          <i class="fa-solid fa-location-dot text-[#a6d37e]" aria-hidden="true"></i>
          <span>{t("footer.contactTitle")}</span>
        </h4>
        <div class="space-y-3 text-sm text-emerald-100/90">
          <div class="flex items-start gap-2.5">
            <i class="fa-solid fa-map-pin text-[#a6d37e] mt-1 shrink-0" aria-hidden="true"></i>
            <div>
              <p class="font-semibold text-white">{t("footer.addressLabel")}</p>
              <p>{company.address.street}</p>
              <p>{company.address.district} • {company.address.city} - {company.address.state}</p>
              <p class="text-xs text-emerald-300/80">CEP {company.address.zip}</p>
            </div>
          </div>

          <div class="flex items-start gap-2.5 pt-1">
            <i class="fa-solid fa-phone text-[#a6d37e] mt-1 shrink-0" aria-hidden="true"></i>
            <div>
              <p class="font-semibold text-white">{t("footer.phonesLabel")}</p>
              {company.phones.map((phone) => (
                <p><a href={`tel:${phone.raw}`} class="hover:text-white focus-visible:ring-2 focus-visible:ring-[#a6d37e] rounded">{phone.display}</a></p>
              ))}
            </div>
          </div>

          <div class="flex items-start gap-2.5 pt-1">
            <i class="fa-solid fa-envelope text-[#a6d37e] mt-1 shrink-0" aria-hidden="true"></i>
            <div>
              <p class="font-semibold text-white">{t("footer.emailLabel")}</p>
              <p><a href={`mailto:${company.email}`} class="hover:text-white break-all focus-visible:ring-2 focus-visible:ring-[#a6d37e] rounded">{company.email}</a></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Barra de Copyright -->
  <div class="border-t border-emerald-950/80 bg-black/30 py-4 px-4 sm:px-6 text-xs text-emerald-200/70">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2 text-center sm:text-left">
      <p>
        © {new Date().getFullYear()} {company.name} - {t("footer.rights")}
      </p>
      <p class="text-emerald-300/60">
        {t("site.tagline")}
      </p>
    </div>
  </div>
</footer>
