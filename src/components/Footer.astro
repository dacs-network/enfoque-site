---
---

<footer class="bg-[#003300] text-white border-t-4 border-[#006400]">
  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      <!-- Col 1: Institucional -->
      <div class="space-y-4">
        <div class="bg-white/95 p-3 rounded-lg inline-block shadow-xs">
          <img
            src="/img/logo.png"
            alt="Enfoque Ambiental"
            width="200"
            height="85"
            class="h-12 w-auto object-contain"
            loading="lazy"
          />
        </div>
        <p class="text-emerald-100/90 text-sm leading-relaxed">
          Há mais de 10 anos oferecendo soluções completas em Engenharia Ambiental, Coleta e Transporte de Resíduos e Licenciamento técnico para os setores público e privado.
        </p>
        <div class="flex items-center gap-3 pt-2">
          <a
            href="https://facebook.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-emerald-950 flex items-center justify-center text-emerald-200 hover:text-white hover:bg-[#006400] transition-colors"
            aria-label="Facebook da Enfoque Ambiental"
          >
            <i class="fa-brands fa-facebook-f text-base" aria-hidden="true"></i>
          </a>
          <a
            href="mailto:contato@enfoqueambiental.com.br"
            class="w-9 h-9 rounded-full bg-emerald-950 flex items-center justify-center text-emerald-200 hover:text-white hover:bg-[#006400] transition-colors"
            aria-label="E-mail de contato"
          >
            <i class="fa-solid fa-envelope text-base" aria-hidden="true"></i>
          </a>
          <a
            href="https://wa.me/551935417975"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-full bg-emerald-950 flex items-center justify-center text-emerald-200 hover:text-white hover:bg-[#006400] transition-colors"
            aria-label="WhatsApp da Enfoque Ambiental"
          >
            <i class="fa-brands fa-whatsapp text-base" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <!-- Col 2: Navegação -->
      <div>
        <h4 class="text-base font-bold text-white uppercase tracking-wider mb-4 pb-2 border-b border-emerald-900 flex items-center gap-2">
          <i class="fa-solid fa-bars text-[#a6d37e]" aria-hidden="true"></i>
          <span>Navegação</span>
        </h4>
        <ul class="space-y-2.5 text-sm text-emerald-100/80">
          <li>
            <a href="/" class="hover:text-white hover:translate-x-1 inline-flex items-center transition-all">
              <i class="fa-solid fa-chevron-right text-xs text-[#a6d37e] mr-1.5" aria-hidden="true"></i> Home
            </a>
          </li>
          <li>
            <a href="/empresa" class="hover:text-white hover:translate-x-1 inline-flex items-center transition-all">
              <i class="fa-solid fa-chevron-right text-xs text-[#a6d37e] mr-1.5" aria-hidden="true"></i> Quem Somos & Metas
            </a>
          </li>
          <li>
            <a href="/servicos" class="hover:text-white hover:translate-x-1 inline-flex items-center transition-all">
              <i class="fa-solid fa-chevron-right text-xs text-[#a6d37e] mr-1.5" aria-hidden="true"></i> Serviços Ambientais
            </a>
          </li>
          <li>
            <a href="/equipamentos" class="hover:text-white hover:translate-x-1 inline-flex items-center transition-all">
              <i class="fa-solid fa-chevron-right text-xs text-[#a6d37e] mr-1.5" aria-hidden="true"></i> Frota & Equipamentos
            </a>
          </li>
          <li>
            <a href="/certificados" class="hover:text-white hover:translate-x-1 inline-flex items-center transition-all">
              <i class="fa-solid fa-chevron-right text-xs text-[#a6d37e] mr-1.5" aria-hidden="true"></i> Certificados & Licenças
            </a>
          </li>
          <li>
            <a href="/contato" class="hover:text-white hover:translate-x-1 inline-flex items-center transition-all">
              <i class="fa-solid fa-chevron-right text-xs text-[#a6d37e] mr-1.5" aria-hidden="true"></i> Contato & Localização
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Serviços Especializados -->
      <div>
        <h4 class="text-base font-bold text-white uppercase tracking-wider mb-4 pb-2 border-b border-emerald-900 flex items-center gap-2">
          <i class="fa-solid fa-truck-droplet text-[#a6d37e]" aria-hidden="true"></i>
          <span>Serviços Especializados</span>
        </h4>
        <ul class="space-y-2.5 text-sm text-emerald-100/80">
          <li>
            <a href="/servicos" class="hover:text-white transition-colors">
              • Coleta e Transporte de Resíduos
            </a>
          </li>
          <li>
            <a href="/servicos" class="hover:text-white transition-colors">
              • Gerenciamento Total de Resíduos
            </a>
          </li>
          <li>
            <a href="/servicos" class="hover:text-white transition-colors">
              • Consultoria e Licenciamento CETESB
            </a>
          </li>
          <li>
            <a href="/servicos" class="hover:text-white transition-colors">
              • CADRI e Regularização IBAMA
            </a>
          </li>
          <li>
            <a href="/servicos" class="hover:text-white transition-colors">
              • Hidrojateamento & Limpeza a Vácuo
            </a>
          </li>
          <li>
            <a href="/servicos" class="hover:text-white transition-colors">
              • Transporte de Produtos e Cargas Perigosas
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Contato & Sede -->
      <div>
        <h4 class="text-base font-bold text-white uppercase tracking-wider mb-4 pb-2 border-b border-emerald-900 flex items-center gap-2">
          <i class="fa-solid fa-location-dot text-[#a6d37e]" aria-hidden="true"></i>
          <span>Central de Atendimento</span>
        </h4>
        <div class="space-y-3 text-sm text-emerald-100/90">
          <div class="flex items-start gap-2.5">
            <i class="fa-solid fa-map-pin text-[#a6d37e] mt-1 shrink-0" aria-hidden="true"></i>
            <div>
              <p class="font-semibold text-white">Sede Operacional:</p>
              <p>Rua Ruperto Malaman, 380</p>
              <p>Distrito Industrial • Araras - SP</p>
              <p class="text-xs text-emerald-300/80">CEP 13602-104</p>
            </div>
          </div>

          <div class="flex items-start gap-2.5 pt-1">
            <i class="fa-solid fa-phone text-[#a6d37e] mt-1 shrink-0" aria-hidden="true"></i>
            <div>
              <p class="font-semibold text-white">Telefones:</p>
              <p><a href="tel:1935417975" class="hover:text-white">(19) 3541 7975</a></p>
              <p><a href="tel:1933219111" class="hover:text-white">(19) 3321 9111</a></p>
            </div>
          </div>

          <div class="flex items-start gap-2.5 pt-1">
            <i class="fa-solid fa-envelope text-[#a6d37e] mt-1 shrink-0" aria-hidden="true"></i>
            <div>
              <p class="font-semibold text-white">E-mail Comercial:</p>
              <p><a href="mailto:contato@enfoqueambiental.com.br" class="hover:text-white break-all">contato@enfoqueambiental.com.br</a></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Legal Bar -->
  <div class="border-t border-emerald-950/80 bg-black/30 py-4 px-4 sm:px-6 text-xs text-emerald-200/70">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2 text-center sm:text-left">
      <p>
        © {new Date().getFullYear()} Enfoque Ambiental - Todos os direitos reservados.
      </p>
      <p class="text-emerald-300/60">
        Engenharia, Transporte e Consultoria Ambiental
      </p>
    </div>
  </div>
</footer>
