---
import { fleet } from "../data/fleet";

interface Props {
  showTitle?: boolean;
}

const { showTitle = true } = Astro.props;
---

<section class="py-16 md:py-20 bg-white" aria-labelledby="equipment-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    {showTitle && (
      <div class="max-w-3xl mb-12 space-y-2">
        <h2 id="equipment-heading" class="text-2xl sm:text-3xl font-extrabold text-[#003300] tracking-tight">
          Nossos Equipamentos
        </h2>
        <p class="text-gray-600 text-base">
          Frota própria para transporte seguro de efluentes, tambores e resíduos industriais:
        </p>
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {fleet.map((vehicle) => (
        <div class="bg-gray-50 p-6 rounded-2xl border border-gray-200/90 shadow-xs flex flex-col justify-between hover:border-[#98c571] transition-colors">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <div class="w-12 h-12 rounded-xl bg-[#003300] text-[#a6d37e] flex items-center justify-center shrink-0">
                <i class={`${vehicle.icon} text-xl`} aria-hidden="true"></i>
              </div>
              {vehicle.capacity && (
                <span class="text-xs font-semibold px-2.5 py-1 rounded-md bg-emerald-100/70 text-emerald-900">
                  {vehicle.capacity}
                </span>
              )}
            </div>

            <div>
              <h3 class="text-lg font-bold text-gray-900">
                {vehicle.name}
              </h3>
              <p class="text-xs text-gray-500 mt-0.5">
                {vehicle.application}
              </p>
            </div>

            <p class="text-sm text-gray-700 leading-relaxed">
              <strong class="font-semibold text-gray-900">Material atendido:</strong> {vehicle.material}
            </p>
          </div>

          <div class="pt-4 mt-4 border-t border-gray-200/60">
            <a
              href="/contato"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-[#006400] hover:text-[#003300]"
            >
              <span>Fale Conosco</span>
              <i class="fa-solid fa-chevron-right text-[10px]" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
