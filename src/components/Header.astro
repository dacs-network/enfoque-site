---
interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const navItems = [
  { label: "Home", href: "/" },
  { label: "Empresa", href: "/empresa" },
  { label: "Serviços", href: "/servicos" },
  { label: "Equipamentos", href: "/equipamentos" },
  { label: "Certificados", href: "/certificados" },
  { label: "Contato", href: "/contato" },
];
---

<header class="w-full bg-white border-b border-gray-200 sticky top-0 z-50 shadow-xs">
  <!-- Top Utility Bar (Verde Floresta Profundo #003300) -->
  <div class="bg-[#003300] text-white text-xs sm:text-sm py-2 px-4 sm:px-6 border-b border-emerald-950">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-2">
      <!-- Localização & Homologações -->
      <div class="flex items-center flex-wrap justify-center gap-3 sm:gap-4 text-emerald-100/90 text-center sm:text-left">
        <span class="inline-flex items-center gap-1.5">
          <i class="fa-solid fa-location-dot text-[#a6d37e]" aria-hidden="true"></i>
          <span>Rua Ruperto Malaman, 380, Distrito Industrial - Araras/SP</span>
        </span>
        <span class="hidden lg:inline text-emerald-600">|</span>
        <span class="hidden lg:inline-flex items-center gap-1.5">
          <i class="fa-solid fa-shield-halved text-[#a6d37e]" aria-hidden="true"></i>
          <span>Licenciada CETESB • IBAMA • ANTT</span>
        </span>
      </div>

      <!-- Contatos Rápidos -->
      <div class="flex items-center gap-3 sm:gap-4 text-emerald-100/90">
        <a href="tel:1935417975" class="hover:text-white transition-colors inline-flex items-center gap-1.5">
          <i class="fa-solid fa-phone text-[#a6d37e]" aria-hidden="true"></i>
          <span>(19) 3541-7975</span>
        </a>
        <span class="text-emerald-700">/</span>
        <a href="tel:1933219111" class="hover:text-white transition-colors">
          <span>(19) 3321-9111</span>
        </a>
        <span class="text-emerald-700 hidden sm:inline">|</span>
        <a href="mailto:contato@enfoqueambiental.com.br" class="hover:text-white transition-colors hidden sm:inline-flex items-center gap-1.5">
          <i class="fa-solid fa-envelope text-[#a6d37e]" aria-hidden="true"></i>
          <span>contato@enfoqueambiental.com.br</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex justify-between items-center h-20 md:h-24">
      <!-- Logo da Empresa -->
      <a href="/" class="flex items-center py-2 shrink-0" aria-label="Enfoque Ambiental - Página Inicial">
        <img
          src="/img/logo.png"
          alt="Logotipo Enfoque Ambiental - Consultoria e Engenharia Ambiental"
          width="240"
          height="100"
          class="h-12 sm:h-16 md:h-18 w-auto object-contain"
          loading="eager"
        />
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2" aria-label="Menu principal">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-3.5 py-2 text-sm lg:text-base font-semibold transition-all rounded-md relative ${
                isActive
                  ? "text-[#003300] bg-[#bfdba7]/40 shadow-xs border-b-2 border-[#006400]"
                  : "text-gray-700 hover:text-[#003300] hover:bg-gray-50"
              }`}
            >
              {item.label}
              {isActive && (
                <span class="absolute bottom-0 left-2 right-2 h-0.5 bg-[#006400] rounded-full"></span>
              )}
            </a>
          );
        })}
      </nav>

      <!-- CTA Button & Mobile Trigger -->
      <div class="flex items-center gap-3">
        <a
          href="/contato"
          class="hidden sm:inline-flex items-center gap-2 bg-[#006400] hover:bg-[#004d00] text-white font-semibold text-sm lg:text-base px-5 py-2.5 rounded-lg shadow-xs hover:shadow transition-all duration-150 transform hover:-translate-y-0.5 active:translate-y-0"
        >
          <i class="fa-solid fa-headset text-[#a6d37e]" aria-hidden="true"></i>
          <span>Solicitar Orçamento</span>
        </a>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-button"
          type="button"
          class="md:hidden inline-flex items-center justify-center p-2.5 rounded-lg text-gray-700 hover:text-[#003300] hover:bg-gray-100 focus:outline-hidden focus:ring-2 focus:ring-[#006400]"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Abrir menu de navegação"
        >
          <i id="menu-icon-bars" class="fa-solid fa-bars text-xl" aria-hidden="true"></i>
          <i id="menu-icon-xmark" class="fa-solid fa-xmark text-xl hidden" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-gray-200 bg-white shadow-lg"
  >
    <div class="px-4 pt-3 pb-6 space-y-1">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`block px-4 py-3 rounded-lg text-base font-semibold transition-colors ${
              isActive
                ? "bg-[#bfdba7]/40 text-[#003300] font-bold border-l-4 border-[#006400]"
                : "text-gray-700 hover:bg-gray-50 hover:text-[#003300]"
            }`}
          >
            {item.label}
          </a>
        );
      })}

      <div class="pt-4 mt-2 border-t border-gray-100">
        <a
          href="/contato"
          class="flex items-center justify-center gap-2 w-full bg-[#006400] text-white font-semibold py-3 px-4 rounded-lg shadow-sm"
        >
          <i class="fa-solid fa-file-invoice text-[#a6d37e]" aria-hidden="true"></i>
          <span>Solicitar Orçamento</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");
  const barsIcon = document.getElementById("menu-icon-bars");
  const xmarkIcon = document.getElementById("menu-icon-xmark");

  if (button && menu && barsIcon && xmarkIcon) {
    button.addEventListener("click", () => {
      const isExpanded = button.getAttribute("aria-expanded") === "true";
      button.setAttribute("aria-expanded", String(!isExpanded));
      menu.classList.toggle("hidden");
      barsIcon.classList.toggle("hidden");
      xmarkIcon.classList.toggle("hidden");
    });
  }
</script>
