---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navItems = [
  { label: t("nav.home"), href: "/" },
  { label: t("nav.empresa"), href: "/empresa" },
  { label: t("nav.servicos"), href: "/servicos" },
  { label: t("nav.equipamentos"), href: "/equipamentos" },
  { label: t("nav.certificados"), href: "/certificados" },
  { label: t("nav.contato"), href: "/contato" },
];
---

<header class="w-full bg-white border-b border-gray-200 sticky top-0 z-50 shadow-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex justify-between items-center h-20 md:h-24">
      <a href="/" class="flex items-center py-2 shrink-0" aria-label={t("site.name")}>
        <img
          src="/img/logo.png"
          alt={t("site.name")}
          width="240"
          height="100"
          class="h-12 sm:h-16 md:h-18 w-auto object-contain"
          loading="eager"
        />
      </a>

      <nav class="hidden md:flex items-center gap-1 lg:gap-2" aria-label={t("nav.home")}>
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-3.5 py-2 text-sm lg:text-base font-semibold transition-all rounded-md focus-visible:ring-2 focus-visible:ring-[#006400] focus-visible:outline-hidden ${
                isActive
                  ? "text-[#003300] bg-[#bfdba7]/40 font-bold"
                  : "text-gray-700 hover:text-[#003300] hover:bg-gray-50"
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <div class="flex items-center gap-3">
        <a
          href="/contato"
          class="hidden sm:inline-flex items-center justify-center bg-[#006400] hover:bg-[#004d00] text-white font-semibold text-sm lg:text-base px-5 py-2.5 rounded-lg shadow-xs hover:shadow transition-all duration-150 transform hover:-translate-y-0.5 active:translate-y-0 focus-visible:ring-2 focus-visible:ring-[#003300] focus-visible:outline-hidden"
        >
          {t("cta.contact")}
        </a>

        <button
          id="mobile-menu-button"
          type="button"
          class="md:hidden inline-flex items-center justify-center p-2.5 rounded-lg text-gray-700 hover:text-[#003300] hover:bg-gray-100 focus:outline-hidden focus:ring-2 focus:ring-[#006400]"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={t("nav.home")}
        >
          <i id="menu-icon" class="fa-solid fa-bars text-xl" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-gray-200 bg-white shadow-lg"
  >
    <div class="px-4 pt-3 pb-6 space-y-1">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`block px-4 py-3 rounded-lg text-base font-semibold transition-colors ${
              isActive
                ? "bg-[#bfdba7]/40 text-[#003300] font-bold border-l-4 border-[#006400]"
                : "text-gray-700 hover:bg-gray-50 hover:text-[#003300]"
            }`}
          >
            {item.label}
          </a>
        );
      })}

      <div class="pt-4 mt-2 border-t border-gray-100">
        <a
          href="/contato"
          class="flex items-center justify-center w-full bg-[#006400] text-white font-semibold py-3 px-4 rounded-lg shadow-sm"
        >
          {t("cta.contact")}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");
  const menuIcon = document.getElementById("menu-icon");

  if (button && menu && menuIcon) {
    const toggleMenu = (forceClose?: boolean) => {
      const isExpanded = button.getAttribute("aria-expanded") === "true";
      const shouldOpen = forceClose ? false : !isExpanded;
      
      button.setAttribute("aria-expanded", String(shouldOpen));
      menu.classList.toggle("hidden", !shouldOpen);
      
      if (shouldOpen) {
        menuIcon.classList.remove("fa-bars");
        menuIcon.classList.add("fa-xmark");
      } else {
        menuIcon.classList.remove("fa-xmark");
        menuIcon.classList.add("fa-bars");
      }
    };

    button.addEventListener("click", () => toggleMenu());

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu.classList.contains("hidden")) {
        toggleMenu(true);
        button.focus();
      }
    });
  }
</script>
