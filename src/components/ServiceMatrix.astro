---
---

<section class="py-16 md:py-20 bg-gray-50 border-t border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Card 1: Serviços -->
      <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-xs flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div class="flex items-center gap-3 pb-4 border-b border-gray-100">
            <div class="w-10 h-10 rounded-lg bg-[#003300] text-[#a6d37e] flex items-center justify-center shrink-0">
              <i class="fa-solid fa-recycle" aria-hidden="true"></i>
            </div>
            <h3 class="text-xl font-bold text-[#003300]">Serviços</h3>
          </div>

          <p class="text-gray-700 text-sm sm:text-base leading-relaxed">
            Entre os principais serviços oferecidos pela Enfoque Ambiental estão:
          </p>

          <ul class="space-y-2.5 text-sm sm:text-base text-gray-800">
            <li class="flex items-center gap-2.5">
              <i class="fa-solid fa-check text-[#006400] text-sm shrink-0" aria-hidden="true"></i>
              <span>Gerenciamento de Resíduos</span>
            </li>
            <li class="flex items-center gap-2.5">
              <i class="fa-solid fa-check text-[#006400] text-sm shrink-0" aria-hidden="true"></i>
              <span>Coleta e Transporte de Resíduos</span>
            </li>
            <li class="flex items-center gap-2.5">
              <i class="fa-solid fa-check text-[#006400] text-sm shrink-0" aria-hidden="true"></i>
              <span>Consultoria e Assessoria Ambiental</span>
            </li>
            <li class="flex items-center gap-2.5">
              <i class="fa-solid fa-check text-[#006400] text-sm shrink-0" aria-hidden="true"></i>
              <span>Elaboração de Normas e Manuais</span>
            </li>
          </ul>
        </div>

        <div class="pt-4 border-t border-gray-100">
          <a
            href="/servicos"
            class="inline-flex items-center gap-2 text-sm font-semibold text-[#003300] hover:text-[#006400] transition-colors group"
          >
            <span>Clique aqui para conhecer todos os serviços oferecidos pela Enfoque Ambiental.</span>
            <i class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1 shrink-0" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <!-- Card 2: Equipamentos -->
      <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-xs flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <div class="flex items-center gap-3 pb-4 border-b border-gray-100">
            <div class="w-10 h-10 rounded-lg bg-[#003300] text-[#a6d37e] flex items-center justify-center shrink-0">
              <i class="fa-solid fa-truck-moving" aria-hidden="true"></i>
            </div>
            <h3 class="text-xl font-bold text-[#003300]">Equipamentos</h3>
          </div>

          <p class="text-gray-700 text-sm sm:text-base leading-relaxed">
            A Enfoque Ambiental conta com equipamentos de última geração:
          </p>

          <ul class="space-y-2.5 text-sm sm:text-base text-gray-800">
            <li class="flex items-center gap-2.5">
              <i class="fa-solid fa-check text-[#006400] text-sm shrink-0" aria-hidden="true"></i>
              <span>Veículos Coletores</span>
            </li>
            <li class="flex items-center gap-2.5">
              <i class="fa-solid fa-check text-[#006400] text-sm shrink-0" aria-hidden="true"></i>
              <span>Transportadores de Resíduos</span>
            </li>
            <li class="flex items-center gap-2.5">
              <i class="fa-solid fa-check text-[#006400] text-sm shrink-0" aria-hidden="true"></i>
              <span>Compactadores</span>
            </li>
            <li class="flex items-center gap-2.5">
              <i class="fa-solid fa-check text-[#006400] text-sm shrink-0" aria-hidden="true"></i>
              <span>Multicargas</span>
            </li>
          </ul>
        </div>

        <div class="pt-4 border-t border-gray-100">
          <a
            href="/equipamentos"
            class="inline-flex items-center gap-2 text-sm font-semibold text-[#003300] hover:text-[#006400] transition-colors group"
          >
            <span>Clique aqui para conhecer todos os equipamentos utilizados pela Enfoque Ambiental.</span>
            <i class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1 shrink-0" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
